# Vorlage — echte Werte gehören in .env (wird nicht committet).
# Bei jeder neuen Variable hier eine leere Zeile ergänzen.
#
# Achtung: alles mit PUBLIC_ landet im Client-Bundle und ist öffentlich.

# PUBLIC_SITE_URL=

# Postfach, über das das Probestunden-Formular die Anfragen verschickt
# (src/pages/api/anfrage.ts). Werte aus dem mStudio, Postfach
# info@lernstabil.de. Port 465 = SSL/TLS, 587 = STARTTLS.
# Fehlt SMTP_HOST, wird im Entwicklungsmodus nur ins Terminal
# geschrieben statt gesendet.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
