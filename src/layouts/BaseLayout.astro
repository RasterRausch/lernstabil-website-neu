---
import '../styles/tokens.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import ProbestundeDialog from '../components/ProbestundeDialog.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  // Das Probestunden-Fenster steht auf jeder Seite, damit jeder Knopf
  // auf /probestunde es oeffnen kann. Nur auf /probestunde selbst nicht:
  // Dort steht dasselbe Formular schon in der Seite.
  probestundeDialog?: boolean;
  // Fuer Seiten, die niemand ueber Google finden soll (Danke-Seite,
  // Fehlerseite des Formulars).
  noindex?: boolean;
  // Aufruf oben im Footer, siehe components/sections/Footer.astro.
  footerAufruf?: 'probestunde' | 'bewerbung';
}

const {
  title,
  description,
  lang = 'de',
  probestundeDialog = true,
  noindex = false,
  footerAufruf = 'probestunde',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    {/* Favicon von der alten Seite uebernommen (28. September 2026):
        weisses # auf rotem Quadrat, 512 px. Das Apple-Touch-Icon ist
        dasselbe Bild auf 180 px, fuer den Home-Bildschirm auf dem iPhone. */}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Beide Schnitte der Textschrift stehen ueber dem Falz — die
        Kursive seit 28. September 2026 in der Telefonnummer der
        Kopfleiste und im Hero —, deshalb beide vorgeladen. */}
    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/comic-neue-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* Six Hands Marker kommt von Adobe Fonts und darf nicht selbst
        gehostet werden. Jeder Aufruf überträgt die IP des Besuchers an
        Adobe — gehört in die Datenschutzerklärung. Siehe CLAUDE.md. */}
    <link rel="stylesheet" href="https://use.typekit.net/chw4hpk.css" />
  </head>
  <body>
    {/* Erste fokussierbare Stelle der Seite. Wer mit der Tastatur
        arbeitet, muss sonst auf jeder Seite erst durch Logo,
        Navigation und Telefonnummer tabben, bevor der Inhalt kommt. */}
    <a class="sprungmarke" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <slot />
    <Footer aufruf={footerAufruf} />
    {probestundeDialog && <ProbestundeDialog />}
  </body>
</html>

<script>
  // Setzt die verschluesselten Telefon- und E-Mail-Links ein. Siehe
  // src/data/kontakt.ts.
  import '../scripts/kontakt-schutz';
</script>

<style is:global>
  /* Selbst gehostet, keine Laufzeitverbindung nach aussen.
     Lizenz SIL OFL 1.1, Lizenztext in public/fonts/. */
  @font-face {
    font-family: 'Comic Neue';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/comic-neue-700-latin.woff2') format('woff2');
  }

  /* Source Sans 3, selbst gehostet seit dem 27. September 2026. Vorher
     kam sie von Google Fonts — damit ging bei jedem Aufruf die IP des
     Besuchers an Google (LG Muenchen I, 3 O 17493/20: ohne Einwilligung
     unzulaessig). Lizenz SIL OFL 1.1, Lizenztext in public/fonts/.

     Die Dateien sind der Latin-Teilsatz, so wie Google ihn ausliefert,
     unveraendert (die OFL reserviert den Namen „Source" fuer
     veraenderte Fassungen). Latin deckt Umlaute, ß, Gedankenstrich,
     deutsche Anfuehrungszeichen und € ab.

     Variable Schrift: Eine Datei traegt alle Gewichte. Freigegeben sind
     400 bis 700 — die drei Schnitte aus tokens.css liegen darin.

     Kursiv ebenfalls als echter Schnitt (Datei unten): Ohne ihn schert
     der Browser die aufrechte Schrift nur schraeg — bei Source Sans 3
     gut sichtbar, weil die echte Kursive andere Buchstabenformen hat
     (a, e, g). */
  @font-face {
    font-family: 'Source Sans 3';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/source-sans-3-latin.woff2') format('woff2');
  }

  /* Seit 28. September 2026 400 bis 700: Die Telefonnummer in der
     Kopfleiste steht fett und kursiv. Die bisherige Datei enthielt nur
     den Schnitt 400 (anders als oben vermerkt) und ist am selben Tag
     durch die variable Fassung von Google ersetzt worden: gleicher
     Latin-Teilsatz, unveraendert, 28 KB statt 16 KB. */
  @font-face {
    font-family: 'Source Sans 3';
    font-style: italic;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/source-sans-3-italic-latin.woff2') format('woff2');
  }

  * {
    box-sizing: border-box;
  }

  /* Sprungmarken der Navigation gleiten statt zu springen (Alexander,
     28. September 2026). scroll-padding-top haelt das Ziel unter der
     klebenden Kopfleiste frei, fuer alle Sprungziele an einer Stelle.
     Wer Bewegung abbestellt hat, springt wie vorher. */
  html {
    scroll-padding-top: var(--layout-header-height);
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Der Markenname „#Lernstabil" steht ueberall in der Schrift des
     Logos, auch mitten im Fliesstext und in der Navigation — Wunsch von
     Alexander am 25. September 2026. Global, weil er in jeder Sektion
     vorkommen kann.

     Comic Neue ist nur im fetten Schnitt geladen (siehe oben). Kursiv
     gibt es nicht; ohne font-style: normal wuerde der Browser sie in
     der kursiven Navigation kuenstlich schraegstellen. */
  .marke {
    font-family: var(--font-family-logo);
    font-weight: var(--font-weight-bold);
    font-style: normal;
  }

  /* Aus dem Blickfeld, aber nicht aus dem Fokusbaum: display:none oder
     visibility:hidden wuerden die Marke auch fuer die Tastatur
     entfernen. Bei Fokus springt sie sichtbar in die linke obere Ecke. */
  .sprungmarke {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    z-index: calc(var(--z-sticky) + 1);
    transform: translateY(-200%);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-deepest);
    color: var(--color-text-default);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .sprungmarke:focus-visible {
    transform: translateY(0);
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Wer „Bewegung reduzieren" eingestellt hat, bekommt keinen
     Uebergang — die Marke ist sofort da. */
  @media (prefers-reduced-motion: no-preference) {
    .sprungmarke {
      transition: transform 150ms ease;
    }
  }

  body {
    margin: 0;
    background: var(--color-surface-default);
    color: var(--color-text-default);
    font-family: var(--font-family-body);
    font-size: var(--font-size-md);
    line-height: var(--line-height-loose);
    -webkit-font-smoothing: antialiased;
  }
</style>
