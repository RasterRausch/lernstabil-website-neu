---
import '../styles/tokens.css';
import Header from '../components/sections/Header.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'de' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="/fonts/comic-neue-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* Six Hands Marker kommt von Adobe Fonts und darf nicht selbst
        gehostet werden. Jeder Aufruf überträgt die IP des Besuchers an
        Adobe — gehört in die Datenschutzerklärung. Siehe CLAUDE.md. */}
    <link rel="stylesheet" href="https://use.typekit.net/chw4hpk.css" />
    {/* ital,wght: Die vier geladenen Schnitte sind 400, 600, 700 aufrecht
        und 400 kursiv. Der Kursivschnitt kam am 2. September 2026 dazu,
        fuer die Hervorhebungen in der zweiten Zeile der Hero-Ueberschrift.
        Ohne echten Schnitt schert der Browser die aufrechte Schrift nur
        schraeg — bei Source Sans 3 gut sichtbar, weil die echte Kursive
        andere Buchstabenformen hat (a, e, g).

        400 ist der einzige kursive Schnitt: Er passt zum Schnitt der
        zweiten Zeile. Wird Kursiv spaeter in einem fetteren Text noetig,
        kommt der passende dazu — nicht vorsorglich. Ein kursiver Schnitt,
        dessen Gewicht nicht geladen ist, wird vom Browser wieder
        synthetisiert; das ist genau der Fall, den wir vermeiden. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {/* Erste fokussierbare Stelle der Seite. Wer mit der Tastatur
        arbeitet, muss sonst auf jeder Seite erst durch Logo,
        Navigation und Telefonnummer tabben, bevor der Inhalt kommt. */}
    <a class="sprungmarke" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  /* Selbst gehostet, keine Laufzeitverbindung nach aussen.
     Lizenz SIL OFL 1.1, Lizenztext in public/fonts/. */
  @font-face {
    font-family: 'Comic Neue';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/comic-neue-700-latin.woff2') format('woff2');
  }

  * {
    box-sizing: border-box;
  }

  /* Der Markenname „#Lernstabil" steht ueberall in der Schrift des
     Logos, auch mitten im Fliesstext und in der Navigation — Wunsch von
     Alexander am 25. September 2026. Global, weil er in jeder Sektion
     vorkommen kann.

     Comic Neue ist nur im fetten Schnitt geladen (siehe oben). Kursiv
     gibt es nicht; ohne font-style: normal wuerde der Browser sie in
     der kursiven Navigation kuenstlich schraegstellen. */
  .marke {
    font-family: var(--font-family-logo);
    font-weight: var(--font-weight-bold);
    font-style: normal;
  }

  /* Aus dem Blickfeld, aber nicht aus dem Fokusbaum: display:none oder
     visibility:hidden wuerden die Marke auch fuer die Tastatur
     entfernen. Bei Fokus springt sie sichtbar in die linke obere Ecke. */
  .sprungmarke {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    z-index: calc(var(--z-sticky) + 1);
    transform: translateY(-200%);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-deepest);
    color: var(--color-text-default);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .sprungmarke:focus-visible {
    transform: translateY(0);
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Wer „Bewegung reduzieren" eingestellt hat, bekommt keinen
     Uebergang — die Marke ist sofort da. */
  @media (prefers-reduced-motion: no-preference) {
    .sprungmarke {
      transition: transform 150ms ease;
    }
  }

  body {
    margin: 0;
    background: var(--color-surface-default);
    color: var(--color-text-default);
    font-family: var(--font-family-body);
    font-size: var(--font-size-md);
    line-height: var(--line-height-loose);
    -webkit-font-smoothing: antialiased;
  }
</style>
