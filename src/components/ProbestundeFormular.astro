---
// Formular „Gratis-Probestunde anfragen". Angelegt am 27. September
// 2026, Entwurf mit Alexander abgestimmt:
//
// DREI SCHRITTE, SECHS FELDER. Erst zwei Fragen, die sich mit einem
// Tipp beantworten lassen und nichts Persoenliches verlangen (Fach,
// Klasse), dann erst Name und Telefon. Wer zwei Fragen beantwortet
// hat, bricht beim dritten Schritt selten ab. Mehrstufig lohnt sich nur,
// solange es kurz bleibt — kein weiteres Pflichtfeld ohne Grund.
//
// TELEFON IST PFLICHT, E-MAIL NICHT: Der Weg zu #Lernstabil ist der
// Anruf. Am 28. September 2026 kurz als Pflichtfeld erwogen und
// verworfen (Alexander) — wer eine Adresse angibt, bekommt daran die
// Eingangsbestaetigung. Keine Einwilligungs-Checkbox — die Anfrage ist eine
// vorvertragliche Massnahme (Art. 6 Abs. 1 lit. b DSGVO), der Hinweis
// auf die Datenschutzerklaerung genuegt.
//
// OHNE JAVASCRIPT stehen alle drei Schritte untereinander, und das
// Formular wird normal abgeschickt (Browser-Pruefung ueber required).
// Mit JavaScript macht src/scripts/probestunde-formular.ts daraus die
// Schritte, prueft selbst und schickt per fetch. Die Klassen
// .nur-mit-js und die Schritt-Anzeige haengen am Attribut
// data-mehrstufig, das erst das Skript setzt.
//
// Auswahlwerte: src/data/probestunde.ts. Versand: pages/api/anfrage.ts.

import Getarnt from "./Getarnt.astro";
import { telefon, verschluesseln } from "../data/kontakt";
import { faecherKacheln, faecherWeitere, klassen, zeiten } from "../data/probestunde";

interface Props {
  // Praefix fuer alle ids, damit Label und Feld eindeutig zusammen-
  // gehoeren. Das Formular steht je Seite nur einmal, trotzdem eindeutig.
  id: string;
  // Ueberschrift im Formular. Auf /probestunde traegt die Seite selbst
  // die Ueberschrift, dort bleibt das leer.
  titel?: string;
}

const { id, titel } = Astro.props;
const i = (name: string) => `${id}-${name}`;
---

<div class="probestunde" data-probestunde>
  <form
    class="formular"
    action="/api/anfrage"
    method="post"
    data-probestunde-formular
    aria-labelledby={titel ? i("titel") : undefined}
  >
    {titel && <h2 class="titel" id={i("titel")}>{titel}</h2>}

    {/* Kopfzeile: links der Schritt, rechts der Ausweg zum Telefon. Wer
        sich mitten im Formular doch fuer den Anruf entscheidet, soll die
        Nummer nicht suchen muessen (Alexander, 28. September 2026). Der
        Telefonweg ist auf der ganzen Seite blau. */}
    <div class="fortschritt">
      <div class="kopfzeile">
        <p class="fortschritt-text nur-mit-js" aria-hidden="true">
          Schritt <span data-schritt-nr>1</span> von 3
        </p>
        <p class="anrufen">
          Lieber anrufen?{" "}
          <a data-kontakt={verschluesseln(telefon.href)}
            ><Getarnt text={telefon.anzeige} /></a
          >
        </p>
      </div>
      <div class="balken nur-mit-js" aria-hidden="true">
        <div class="balken-fuellung" data-balken></div>
      </div>
    </div>

    {/* Schritt 1: Fach ---------------------------------------------- */}
    <fieldset class="schritt" data-schritt="1" aria-describedby={i("fach-fehler")}>
      <legend class="frage" tabindex="-1">
        <span class="nur-vorlesen">Schritt 1 von 3: </span>Für welches Fach
        suchen Sie Nachhilfe?
      </legend>
      <div class="kacheln">
        {
          [...faecherKacheln, "Anderes Fach"].map((f) => (
            <label class="kachel">
              <input type="radio" name="fach" value={f} required />
              <span>{f}</span>
            </label>
          ))
        }
      </div>
      <div class="anderes" data-anderes>
        <label class="feld-label" for={i("fach-anderes")}>Welches Fach?</label>
        <select class="eingabe" id={i("fach-anderes")} name="fach_anderes">
          <option value="">Bitte wählen</option>
          {faecherWeitere.map((f) => <option value={f}>{f}</option>)}
        </select>
      </div>
      <p class="fehler" id={i("fach-fehler")} data-fehler="fach"></p>
      {/* Links neben „Weiter", was die Probestunde ist (Alexander,
          29. September 2026). Stand bis dahin als Fussnote zu einem
          Sternchen an jedem Probestunden-Knopf der Seite; hier steht er
          einmal, im Moment der Entscheidung und ohne Sternchen. Nur in
          Schritt 1: In Schritt 2 und 3 steht links „Zurueck". */}
      <div class="steuerung nur-mit-js">
        <p class="steuerung-hinweis">
          Die Gratis-Probestunde dauert 45&nbsp;Minuten und dient zugleich
          als Leistungsanalyse.
        </p>
        <button class="knopf-weiter" type="button" data-weiter>Weiter</button>
      </div>
    </fieldset>

    {/* Schritt 2: Klasse -------------------------------------------- */}
    <fieldset class="schritt" data-schritt="2" aria-describedby={i("klasse-fehler")}>
      <legend class="frage" tabindex="-1">
        <span class="nur-vorlesen">Schritt 2 von 3: </span>Welche Klasse
        besucht Ihr Kind?
      </legend>
      <div class="kacheln kacheln-breit">
        {
          klassen.map((k) => (
            <label class="kachel">
              <input type="radio" name="klasse" value={k.wert} required />
              <span>
                {k.wert}
                {k.zusatz && <small>{k.zusatz}</small>}
              </span>
            </label>
          ))
        }
      </div>
      <p class="fehler" id={i("klasse-fehler")} data-fehler="klasse"></p>
      <div class="steuerung nur-mit-js">
        <button class="knopf-zurueck" type="button" data-zurueck>Zurück</button>
        <button class="knopf-weiter" type="button" data-weiter>Weiter</button>
      </div>
    </fieldset>

    {/* Schritt 3: Kontakt ------------------------------------------- */}
    <fieldset class="schritt" data-schritt="3">
      <legend class="frage" tabindex="-1">
        <span class="nur-vorlesen">Schritt 3 von 3: </span>Wie erreichen wir
        Sie?
      </legend>

      <div class="feld">
        <label class="feld-label" for={i("vorname")}>Ihr Vorname</label>
        <input
          class="eingabe"
          id={i("vorname")}
          name="vorname"
          type="text"
          autocomplete="given-name"
          maxlength="60"
          required
          aria-describedby={i("vorname-fehler")}
        />
        <p class="fehler" id={i("vorname-fehler")} data-fehler="vorname"></p>
      </div>

      <div class="feld">
        <label class="feld-label" for={i("telefon")}>Telefonnummer</label>
        <input
          class="eingabe"
          id={i("telefon")}
          name="telefon"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          maxlength="30"
          required
          aria-describedby={i("telefon-fehler")}
        />
        <p class="fehler" id={i("telefon-fehler")} data-fehler="telefon"></p>
      </div>

      <div class="feld">
        <label class="feld-label" for={i("email")}>
          E-Mail-Adresse <span class="optional">(optional)</span>
        </label>
        <input
          class="eingabe"
          id={i("email")}
          name="email"
          type="email"
          autocomplete="email"
          maxlength="120"
          aria-describedby={i("email-fehler")}
        />
        <p class="fehler" id={i("email-fehler")} data-fehler="email"></p>
      </div>

      <fieldset class="zeiten">
        <legend class="feld-label">
          Wann erreichen wir Sie am besten? <span class="optional">(optional)</span>
        </legend>
        <div class="chips">
          {
            zeiten.map((z) => (
              <label class="kachel chip">
                <input type="checkbox" name="zeiten" value={z} />
                <span>{z}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      {/* Honigtopf: fuer Menschen unsichtbar, fuer Bots ein Feld wie jedes
          andere. Nicht display: none — manche Bots ueberspringen genau
          das. Zeitstempel t setzt das Skript. */}
      <div class="honig" aria-hidden="true">
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <input type="hidden" name="t" data-zeit />

      <p class="fehler" data-fehler="formular" role="alert"></p>
      <p class="versand-fehler" data-versand-fehler hidden>
        Das hat leider nicht geklappt. Bitte versuchen Sie es noch einmal oder
        rufen Sie uns an:{" "}
        <a data-kontakt={verschluesseln(telefon.href)}
          ><Getarnt text={telefon.anzeige} /></a
        >.
      </p>

      <div class="steuerung">
        <button class="knopf-zurueck nur-mit-js" type="button" data-zurueck>Zurück</button>
        <button class="knopf-weiter knopf-senden" type="submit" data-senden>
          Gratis-Probestunde anfragen
        </button>
      </div>

      <p class="hinweis">
        Wir melden uns innerhalb von 24 Stunden. Ihre Angaben nutzen wir nur
        für Ihre Anfrage – mehr dazu in der <a href="/datenschutz"
          >Datenschutzerklärung</a
        >.
      </p>
    </fieldset>
  </form>

  {/* Bestaetigung. Inhalt der Probestunde wie in den Fragen (Sektion 8),
      von Alexander bestaetigt am 25. September 2026. */}
  <div class="erfolg" data-erfolg hidden>
    <h2 class="erfolg-titel" tabindex="-1" data-erfolg-titel>
      Danke<span data-erfolg-name></span>!
    </h2>
    <p>
      Ihre Anfrage ist bei uns angekommen. <strong
        >Wir melden uns innerhalb von 24 Stunden.</strong
      >
    </p>
    <p>
      Die Probestunde dauert 45 Minuten und kostet nichts. Am Ende bekommen
      Sie einen Unterrichtsplan – verpflichtet sind Sie zu nichts.
    </p>
    <p class="erfolg-telefon">
      Lieber gleich sprechen?{" "}
      <a data-kontakt={verschluesseln(telefon.href)}
        ><Getarnt text={telefon.anzeige} /></a
      >, Mo bis Fr von 9 bis 20 Uhr.
    </p>
  </div>
</div>

<script>
  import "../scripts/probestunde-formular";
</script>

<style>
  /* Das Formular steht immer auf heller Flaeche — im Dialog wie auf der
     eigenen Seite. Deshalb durchgehend die inverse Textrolle. */
  .probestunde {
    color: var(--color-text-inverse);
  }

  .formular {
    display: grid;
    gap: var(--space-6);
  }

  /* display: grid oben ueberstimmt sonst das hidden-Attribut, und das
     Formular bliebe nach dem Absenden neben der Bestaetigung stehen. */
  .formular[hidden] {
    display: none;
  }

  /* xl auf dem Handy: bei 2xl lief der Titel auf zwei Zeilen und schob
     die erste Frage unnoetig weit nach unten. */
  .titel {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  /* Neben „Weiter": klein und gedaempft wie die Schrittanzeige. Die
     Breite haelt den Satz auf zwei Zeilen, damit er den Knopf nicht
     nach rechts draengt. */
  .steuerung-hinweis {
    margin: 0;
    max-width: var(--measure-narrow);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--color-text-inverse-subtle);
  }

  /* Fortschritt ---------------------------------------------------------
     Rot wie der Knopf, der das Formular geoeffnet hat. --anteil setzt
     das Skript (1/3, 2/3, 3/3). */
  /* Schritt und Telefon in einer Zeile. Wird es zu eng (Handy), rutscht
     das Telefon unter den Schritt statt sich zu quetschen. Ohne Skript
     fehlt der Schritt, das Telefon steht dann allein. */
  .fortschritt {
    display: grid;
    gap: var(--space-2);
  }

  .kopfzeile {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .fortschritt-text,
  .anrufen {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse-subtle);
  }

  .anrufen {
    margin-left: auto;
  }

  .anrufen a {
    color: var(--color-action);
    white-space: nowrap;
  }

  .anrufen a:hover {
    color: var(--color-action-strong);
  }

  .balken {
    height: var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-surface-inverse-muted);
    overflow: hidden;
  }

  .balken-fuellung {
    --anteil: 0.3333;

    height: 100%;
    width: calc(var(--anteil) * 100%);
    background: var(--color-brand);
    border-radius: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .balken-fuellung {
      transition: width 250ms ease;
    }
  }

  /* Schritte -------------------------------------------------------------- */
  .schritt,
  .zeiten {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .schritt {
    display: grid;
    gap: var(--space-4);
  }

  /* Mit Skript nur der aktive Schritt; ohne stehen alle untereinander. */
  .formular[data-mehrstufig] .schritt:not([data-aktiv]) {
    display: none;
  }

  .formular:not([data-mehrstufig]) .nur-mit-js {
    display: none;
  }

  .frage {
    padding: 0;
    margin-bottom: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  .frage:focus {
    outline: none;
  }

  /* Kacheln ---------------------------------------------------------------
     Die ganze Kachel ist das Tippziel, das Radio selbst ist nur optisch
     versteckt — Tastatur und Screenreader bedienen es wie gewohnt
     (Pfeiltasten in der Gruppe). */
  .kacheln {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .kacheln-breit {
    grid-template-columns: 1fr;
  }

  /* „Anderes Fach" ueber die volle Breite: Es ist die Ausweichtuer,
     keine siebte Wahl zwischen gleichrangigen Faechern. */
  .kacheln:not(.kacheln-breit) .kachel:last-child {
    grid-column: 1 / -1;
  }

  .kachel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Tippziel plus Luft: Kacheln sind die Hauptbedienung, sie duerfen
       groesser sein als das Minimum. */
    min-height: calc(var(--tap-target-min) + var(--space-3));
    padding: var(--space-3) var(--space-4);
    /* Drei Zustaende, klar unterscheidbar (28. September 2026 — vorher
       weiss mit grauem Rand, und beim Ueberfahren wurde nur der Rand
       etwas dunkler; Alexander: „sieht man kaum"):
         Ruhe      graue Flaeche, duenner grauer Rand
         Hover     weiss, roter Rand, hebt sich leicht an
         gewaehlt  rot gefuellt, weisse Schrift — wie der Knopf „Weiter"
       Rot, weil das Formular der Weg zur Probestunde ist und dort alles
       rot ist: Fortschritt, Weiter, Senden.

       Der duenne Rand in Ruhe seit 28. September 2026 (Alexander): Ohne
       ihn hob sich die Kachel kaum vom Weiss ab (1,1:1); WCAG 1.4.11
       verlangt 3:1 fuer die Grenze eines Bedienelements —
       --color-border-inverse erreicht 5,3:1. Beim Hover und in der Wahl
       verstaerkt ein innerer Schatten den Rand auf 2 px, ohne dass die
       Kachel ihre Groesse aendert.

       --kachel-rand: Strichstaerke, Geometrie der Zeichnung. */
    --kachel-rand: 1px;

    border: var(--kachel-rand) solid var(--color-border-inverse);
    border-radius: var(--radius-sm);
    background: var(--color-surface-inverse-muted);
    text-align: center;
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-normal);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .kachel {
      transition:
        background-color 120ms ease-out,
        border-color 120ms ease-out,
        box-shadow 120ms ease-out,
        transform 120ms ease-out;
    }
  }

  .kachel small {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-inverse-subtle);
  }

  .kachel input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .kachel:hover {
    border-color: var(--color-brand);
    background: var(--color-surface-inverse);
    box-shadow:
      inset 0 0 0 var(--kachel-rand) var(--color-brand),
      var(--shadow-md);
    transform: translateY(calc(-1 * var(--space-1) / 2));
  }

  /* Rot auf Weiss bzw. Weiss auf Rot: 5,70:1, auch der kleine Zusatz
     („Klasse 1–4") bleibt lesbar. */
  .kachel:has(input:checked) {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
    box-shadow: none;
    transform: none;
  }

  .kachel:has(input:checked) small {
    color: var(--color-text-on-brand);
  }

  .kachel:has(input:checked):hover {
    border-color: var(--color-brand-strong);
    background: var(--color-brand-strong);
  }

  .kachel:has(input:focus-visible) {
    outline: var(--focus-ring-width) solid var(--color-focus-ring-inverse);
    outline-offset: var(--focus-ring-offset);
  }

  .anderes {
    display: grid;
    gap: var(--space-2);
  }

  /* Mit Skript erst sichtbar, wenn „Anderes Fach" gewaehlt ist. */
  .formular[data-mehrstufig] .anderes:not([data-offen]) {
    display: none;
  }

  /* Felder ---------------------------------------------------------------- */
  .feld {
    display: grid;
    gap: var(--space-2);
  }

  .feld-label {
    padding: 0;
    font-weight: var(--font-weight-semibold);
  }

  .optional {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-inverse-subtle);
  }

  /* font-size md ist 17 px oder mehr — unter 16 px zoomt iOS beim
     Antippen ins Feld hinein. */
  .eingabe {
    width: 100%;
    min-height: var(--tap-target-min);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-inverse);
    border-radius: var(--radius-sm);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    font: inherit;
  }

  .eingabe:hover {
    border-color: var(--color-text-inverse);
  }

  .eingabe:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring-inverse);
    outline-offset: var(--focus-ring-offset);
  }

  .eingabe[aria-invalid="true"] {
    border-color: var(--color-brand);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .chip {
    min-height: var(--tap-target-min);
    padding: var(--space-2) var(--space-4);
    font-weight: var(--font-weight-regular);
  }

  /* Fehler ------------------------------------------------------------------
     Rot auf Weiss: #d00000 erreicht 5,70:1 — auch fuer kleine Schrift. */
  .fehler {
    margin: 0;
    color: var(--color-brand);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
  }

  .fehler:empty {
    display: none;
  }

  .versand-fehler {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: var(--space-1) solid var(--color-brand);
    background: var(--color-surface-inverse-muted);
  }

  /* Steuerung ------------------------------------------------------------- */
  .steuerung {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .knopf-weiter {
    margin-left: auto;
    min-height: var(--tap-target-min);
    padding: var(--space-3) var(--space-8);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
    font: inherit;
    font-style: italic;
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .knopf-weiter:hover {
    background: var(--color-brand-strong);
  }

  .knopf-weiter:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  .knopf-weiter[disabled] {
    cursor: progress;
    background: var(--color-brand-strong);
  }

  /* Auf dem Handy ueber die volle Breite, „Zurueck" darunter: Neben
     „Zurueck" brach die Beschriftung auf zwei Zeilen um. */
  .steuerung:has(.knopf-senden) {
    flex-wrap: wrap;
    justify-content: center;
  }

  .knopf-senden {
    flex: 1 1 100%;
    order: -1;
  }

  .knopf-zurueck {
    min-height: var(--tap-target-min);
    padding: var(--space-3) 0;
    border: 0;
    background: none;
    color: var(--color-action);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .knopf-weiter:focus-visible,
  .knopf-zurueck:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring-inverse);
    outline-offset: var(--focus-ring-offset);
  }

  .hinweis {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-inverse-subtle);
  }

  .probestunde a:not([class]) {
    color: var(--color-action);
  }

  /* Honigtopf: aus dem Bild geschoben statt versteckt. */
  .honig {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .nur-vorlesen {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Bestaetigung ------------------------------------------------------------ */
  .erfolg {
    display: grid;
    gap: var(--space-3);
  }

  .erfolg[hidden] {
    display: none;
  }

  .erfolg p {
    margin: 0;
  }

  .erfolg-titel {
    margin: 0;
    font-family: var(--font-family-display);
