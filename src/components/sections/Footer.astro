---
import Unterstrichen from "../Unterstrichen.astro";
import Getarnt from "../Getarnt.astro";
import Beratung from "../Beratung.astro";
import { telefon, email, bewerbung, verschluesseln } from "../../data/kontakt";

interface Props {
  // Welcher Aufruf oben steht. „bewerbung" auf der Seite „Dozent werden"
  // (seit 28. September 2026): Dort lesen Bewerber, keine Eltern — die
  // Probestunde waere der falsche Schluss.
  aufruf?: "probestunde" | "bewerbung";
}

const { aufruf = "probestunde" } = Astro.props;
// Sektion: Footer (seitenübergreifend, 9)
//
// Angelegt am 27. September 2026. Entwurf mit Alexander abgestimmt:
//
// - SCHWARZE FLAECHE (--color-surface-deepest). Die Fragen davor sind
//   hellgrau — hell auf Schwarz ist der staerkste Wechsel, den die Seite
//   hat.
// - LETZTER AUFRUF oben. Wer bis hierher liest, ist noch unentschlossen.
//   Derselbe Aufbau wie im Hero: der rote Probestunden-Knopf, darunter
//   der Anruf als Zeile (components/Beratung.astro).
//
// Die grosse Wortmarke am unteren Rand ist am 27. September 2026 auf
// Alexanders Wunsch wieder entfallen.
//
// Telefon und E-Mail sind gegen Adresssammler geschuetzt, siehe
// src/data/kontakt.ts.
//
// Keine Anschrift: Online-Nachhilfe, die Anschrift steht im Impressum.
// Keine sozialen Netzwerke, es gibt derzeit keine Profile.
//
// „Probestunde anfragen" oeffnet das Formular wie alle anderen
// Probestunden-Knoepfe (href="/probestunde", siehe
// components/ProbestundeDialog.astro).
//
// Links auf Sektionen der Startseite mit „/" davor: Der Footer steht
// auch auf Impressum und Datenschutz. Nur Ziele, die es gibt.

// kontakt: verschluesseltes Linkziel statt href, text wird getarnt.
const spalten: {
  titel: string;
  links: { text: string; href?: string; kontakt?: string }[];
}[] = [
  {
    titel: "Nachhilfe",
    links: [
      { text: "Preise", href: "/#preise" },
      { text: "Häufige Fragen", href: "/#fragen" },
      { text: "Dozent werden", href: "/fuer-dozenten" },
    ],
  },
  {
    titel: "Kontakt",
    links: [
      { text: telefon.anzeige, kontakt: verschluesseln(telefon.href) },
      { text: email.anzeige, kontakt: verschluesseln(email.href) },
    ],
  },
  {
    titel: "Rechtliches",
    links: [
      { text: "Impressum", href: "/impressum" },
      { text: "Datenschutz", href: "/datenschutz" },
    ],
  },
];

const jahr = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    {
      aufruf === "bewerbung" && (
        <div class="aufruf">
          <p class="aufruf-titel">
            Bereit <Unterstrichen>loszulegen?</Unterstrichen>
            <span class="aufruf-zeile">
              Schreiben Sie uns eine kurze E-Mail mit Lebenslauf und Ihren
              Fächern.
            </span>
          </p>
          <div class="knoepfe">
            <a class="knopf-probe" data-kontakt={verschluesseln(bewerbung.href)}>
              E-Mail schreiben
            </a>
          </div>
          <p class="zeiten">
            <Getarnt text={bewerbung.anzeige} />. Wir melden uns innerhalb weniger
            Tage.
          </p>
        </div>
      )
    }

    {aufruf === "probestunde" && (
    <div class="aufruf">
      <p class="aufruf-titel">
        Die erste Stunde ist <Unterstrichen>gratis.</Unterstrichen>
        <span class="aufruf-zeile">Alles danach ohne Vertrag.</span>
      </p>

      {/* Wie im Hero (Alexander, 28. September 2026): ein Knopf, darunter
          der Anruf als Zeile. Vorher Telefon-Knopf und Probestunde
          nebeneinander, darunter „Mo bis Fr, 9 bis 20 Uhr". */}
      <div class="knoepfe">
        <a class="knopf-probe" href="/probestunde">Probestunde anfragen</a>
      </div>
      <Beratung />
    </div>
    )}

    <nav class="spalten" aria-label="Fußbereich">
      {
        spalten.map((s) => (
          <div class="spalte">
            <h2 class="spalte-titel">{s.titel}</h2>
            <ul>
              {s.links.map((l) => (
                <li>
                  {l.kontakt ? (
                    <a data-kontakt={l.kontakt}>
                      <Getarnt text={l.text} />
                    </a>
                  ) : (
                    <a href={l.href}>{l.text}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <p class="copyright">
      © {jahr} <span class="marke">#Lernstabil</span> · Online-Nachhilfe im
      Einzelunterricht
    </p>
  </div>
</footer>

<style>
  /* sunken statt deepest (29. September 2026, Alexander): Reines Schwarz
     fiel neben den abgestuften Dunkeltoenen der Seite heraus. #111 ist
     die dunkelste Stufe, die auch Sektionen tragen. */
  .footer {
    background: var(--color-surface-sunken);
    color: var(--color-text-default);
    padding: var(--space-18) 0 var(--space-12);
  }

  .wrap {
    width: 100%;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  /* Letzter Aufruf ------------------------------------------------------
     Displayschrift wie „ONLINE NACHHILFE" im Hero: Der Footer ist die
     zweite laute Stelle der Seite, nicht eine weitere Sektion. Kein h2 —
     der Satz ist ein Aufruf, keine Ueberschrift fuer den Inhalt darunter. */
  .aufruf {
    text-align: center;
  }

  /* Die Zeile „Gratis Beratung" mittig wie der ganze Aufruf. */
  .aufruf :global(.beratung) {
    justify-content: center;
  }

  .aufruf-titel {
    margin: 0 auto;
    max-width: 20ch;
    font-family: var(--font-family-display);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-display);
    line-height: var(--line-height-snug);
  }

  .aufruf-zeile {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--font-size-xl);
    color: var(--color-text-subtle);
  }

  .knoepfe {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .knopf-probe {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap-target-min);
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-md);
    font-style: italic;
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .knopf-probe {
    background: var(--color-brand);
    color: var(--color-text-on-brand);
  }

  .knopf-probe:hover {
    background: var(--color-brand-strong);
  }

  .knopf-probe:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  .zeiten {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  /* Spalten --------------------------------------------------------------
     Gedaempft, damit sie dem Aufruf nicht die Wirkung nehmen. Die
     Trennlinie darueber setzt den Aufruf als eigenen Block ab. */
  .spalten {
    margin-top: var(--space-18);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border-default);
    display: grid;
    /* Auf dem Handy zwei Spalten: untereinander wurde der Footer
       laenger als der Bildschirm. Die E-Mail-Adresse ist der breiteste
       Eintrag und passt in eine halbe Zeile. */
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8) var(--space-6);
  }

  .spalte-titel {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
    color: var(--color-text-default);
  }

  .spalte ul {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  /* 44 px Tippflaeche (WCAG 2.2, Target Size) — die Links stehen dicht
     untereinander und werden auf dem Handy mit dem Daumen getroffen. */
  .spalte a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    color: var(--color-text-subtle);
    text-decoration: none;
  }

  .spalte a:hover {
    color: var(--color-text-default);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .copyright {
    margin: var(--space-12) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  /* ab 768 --------------------------------------------------------------- */

  @media (min-width: 768px) {
    .footer {
      padding-top: var(--space-28);
    }

    .aufruf-titel {
      font-size: var(--font-size-5xl);
    }

    .aufruf-zeile {
      font-size: var(--font-size-2xl);
    }

    .knoepfe {
      flex-direction: row;
      justify-content: center;
    }

    .spalten {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
