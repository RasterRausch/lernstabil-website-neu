---
// Sektion: Header (seitenübergreifend, 1)
// Spezifikation: design/shared/sections/01-header/spec.md
//
// Die Komponente setzt keine eigenen Farb- und Abstandswerte. Sie
// erwartet die Variablen der Seite: --accent-dark, --leiste-h,
// --content-max, --gutter, --space-*, --radius-sm.

const telefon = '0341 658 329 18';
const telefonHref = 'tel:+4934165832918';

const links = [
  { text: 'Fächer', href: '#faecher' },
  { text: 'Dozent werden', href: '/fuer-dozenten' },
  { text: 'Warum #Lernstabil', href: '#warum' },
  { text: 'Preise', href: '#preise' },
];
---

<header class="leiste" data-leiste>
  <div class="raster">
    <a class="logo" href="/" aria-label="#Lernstabil — Startseite">
      <span class="logo-wort">#Lernstabil</span>
      <span class="logo-claim">Nachhilfe bequem von zu Hause!</span>
    </a>

    <nav class="nav" id="hauptnav" aria-label="Hauptnavigation">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.text}</a></li>
        ))}
      </ul>
    </nav>

    <a
      class="kontakt"
      href={telefonHref}
      aria-label={`Anrufen: ${telefon}`}
    >
      {/* Selbst gezeichnet, kein Icon-Paket. Umriss, Strichstärke 2. */}
      <svg
        class="hoerer"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M4 3h4l2 5-2.5 1.5a12.5 12.5 0 0 0 7 7L16 14l5 2v4h-1C11 20 4 13 4 4V3z"
        ></path>
      </svg>
      <span class="kontakt-nummer">{telefon}</span>
    </a>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="hauptnav"
      aria-label="Menü öffnen"
      data-burger
    >
      <span class="burger-strich"></span>
      <span class="burger-strich"></span>
      <span class="burger-strich"></span>
    </button>
  </div>
</header>

<script>
  const leiste = document.querySelector('[data-leiste]');
  const burger = document.querySelector('[data-burger]');
  const nav = document.getElementById('hauptnav');

  if (leiste && burger && nav) {
    const setzen = (offen) => {
      leiste.classList.toggle('offen', offen);
      burger.setAttribute('aria-expanded', String(offen));
      burger.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
      if (offen) nav.querySelector('a')?.focus();
    };

    burger.addEventListener('click', () => {
      setzen(burger.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) setzen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && leiste.classList.contains('offen')) {
        setzen(false);
        burger.focus();
      }
    });

    // Beim Wechsel in die zweispaltige Ansicht ist der Burger weg —
    // dann darf kein offener Zustand zurückbleiben.
    matchMedia('(min-width: 1120px)').addEventListener('change', (e) => {
      if (e.matches) setzen(false);
    });
  }
</script>

<style>
  .leiste {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--accent-dark);
    color: var(--accent-contrast);
  }

  .raster {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--leiste-h);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* Logo ------------------------------------------------------------
     CSS-Nachbau, Maßverhältnisse aus design/brand/logo.svg. Alle Werte
     sind Bruchteile der Blockbreite --logo-b; der Block trägt
     font-size: var(--logo-b), dadurch ist 1em = Blockbreite.

     Der Block trägt accent, die Leiste accent-dark. Zusammen mit
     Rundung und Schatten setzt er sich damit als eigene Fläche ab,
     statt in der Leiste zu verschwinden. Siehe spec.md, Abschnitt
     „Farbe". */
  .logo {
    --logo-b: 180px;
    align-self: flex-start;
    position: relative;
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    box-sizing: border-box;
    flex: none;
    width: var(--logo-b);
    font-size: var(--logo-b);
    background: var(--accent);
    color: var(--accent-contrast);
    /* Nur unten gerundet. Die Oberkante liegt buendig auf der
       Oberkante der Leiste — eine Rundung dort saehe aus wie ein
       Fehler, nicht wie eine Kante. */
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    box-shadow: var(--schatten-sm);
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    /* Die vier Innenabstaende stammen aus design/brand/logo.svg.
       --logo-luft kommt oben und unten zusaetzlich dazu und ist der
       einzige Wert, den man zum Nachjustieren anfassen muss. Bei 0
       entspricht der Block exakt dem SVG. */
    --logo-luft: 0.016em;
    padding: calc(0.0279em + var(--logo-luft)) 0.0621em
      calc(0.0481em + var(--logo-luft)) 0.0571em;
    gap: 0.01157em;
  }

  .logo-wort {
    font-size: 0.18691em;
    letter-spacing: -0.02em;
  }

  .logo-claim {
    font-size: 0.06765em;
    letter-spacing: -0.033em;
    word-spacing: 0.0103em;
  }

  /* Navigation ------------------------------------------------------ */

  .nav {
    display: none;
  }

  .leiste.offen .nav {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1;
    background: var(--accent-dark);
  }

  .nav ul {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-sm) var(--gutter) var(--space-md);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .nav a {
    color: var(--accent-contrast);
    text-decoration: none;
    font-weight: 600;
    font-style: italic;
  }

  .nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .nav a:active {
    opacity: 0.75;
  }

  /* Kontakt --------------------------------------------------------- */

  .kontakt {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--accent-contrast);
    text-decoration: none;
    flex: none;
  }

  .hoerer {
    width: 22px;
    height: 22px;
    flex: none;
  }

  .kontakt-nummer {
    display: none;
    font-size: var(--fs-body);
    font-weight: 600;
    font-style: italic;
    white-space: nowrap;
  }

  .kontakt:hover .kontakt-nummer {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* Burger ---------------------------------------------------------- */

  .burger {
    flex: none;
    width: 44px;
    height: 44px;
    padding: 11px 10px;
    margin-right: -10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .burger-strich {
    display: block;
    height: 2px;
    background: var(--accent-contrast);
    border-radius: 1px;
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .leiste.offen .burger-strich:nth-child(1) {
    transform: translateY(10px) rotate(45deg);
  }

  .leiste.offen .burger-strich:nth-child(2) {
    opacity: 0;
  }

  .leiste.offen .burger-strich:nth-child(3) {
    transform: translateY(-10px) rotate(-45deg);
  }

  /* Fokus ------------------------------------------------------------ */

  .logo:focus-visible,
  .nav a:focus-visible,
  .kontakt:focus-visible,
  .burger:focus-visible {
    outline: 2px solid var(--accent-contrast);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ab 768 ----------------------------------------------------------- */

  @media (min-width: 768px) {
    .logo {
      --logo-b: 210px;
    }

    .hoerer {
      width: 24px;
      height: 24px;
    }

    .kontakt-nummer {
      display: inline;
    }
  }

  /* ab 1120 — volle Fassung ------------------------------------------ */

  @media (min-width: 1120px) {
    .logo {
      --logo-b: 240px;
    }

    .nav,
    .leiste.offen .nav {
      display: block;
      position: static;
      margin-left: var(--space-xl);
      background: none;
    }

    .nav ul {
      max-width: none;
      margin: 0;
      padding: 0;
      flex-direction: row;
      gap: var(--space-lg);
    }

    /* margin-left bleibt auto — die Gruppe steht rechts im Raster.
       var(--space-lg) ist nur der Mindestabstand zur Navigation. */
    .kontakt {
      padding-left: var(--space-lg);
    }

    .burger {
      display: none;
    }
  }
</style>
