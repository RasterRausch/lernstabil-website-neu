---
import { zug } from "../../data/zeichnungen";
// Sektion: Header (seitenübergreifend, 1)
// Die Komponente setzt keine eigenen Farb- und Abstandswerte. Sie
// arbeitet ausschliesslich mit den semantischen Rollen aus
// src/styles/tokens.css. Ausnahme ist die Geometrie des Logoblocks:
// Sie stammt aus public/bilder/logo.svg und ist unten begruendet.

import Getarnt from "../Getarnt.astro";
import { telefon, verschluesseln } from "../../data/kontakt";

// marke: Markenname hinter dem Text, in der Schrift des Logos (globale
// Klasse .marke im BaseLayout).
//
// „Dozent werden" ist am 28. September 2026 aus der Leiste raus
// (Alexander): Die Seite richtet sich an Eltern, der Link lenkte ab. Er
// steht weiter im Footer. „Warum #Lernstabil" fuehrt zu Sektion 3
// („Echte Foerderung statt Franchise-Fliessband"), „Faecher" zu
// Sektion 6 — beide Ziele fehlten bis dahin.
const links: { text: string; href: string; marke?: string }[] = [
  { text: "Fächer", href: "/#faecher" },
  { text: "Warum", marke: "#Lernstabil", href: "/#warum" },
  { text: "Preise", href: "/#preise" },
];

// Markerzug unter dem Link beim Ueberfahren (`zug`, oben importiert):
// derselbe wie unter den Sektionsueberschriften.
---

<header class="leiste" data-leiste>
  <div class="raster">
    {/* Kein aria-label: Der Name des Links ist sein sichtbarer Text.
        „#Lernstabil — Startseite" wich davon ab — wer per Sprache
        „#Lernstabil" sagt, traf den Link nicht (Lighthouse,
        28. September 2026). */}
    <a class="logo" href="/">
      <span class="logo-wort">#Lernstabil</span>
      <span class="logo-claim">Nachhilfe bequem von zu Hause!</span>
    </a>

    <nav class="nav" id="hauptnav" aria-label="Hauptnavigation">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                {/* Text in einer Klammer: Im Menue ist der Link eine
                    Flex-Zeile. Ohne Klammer verteilte sie „Warum" und
                    „#Lernstabil" als zwei Teile ueber die Zeile. */}
                <span class="link-text">
                  {l.text}
                  {l.marke && (
                    <>
                      {" "}
                      <span class="marke">{l.marke}</span>
                    </>
                  )}
                </span>
                <svg
                  class="zug"
                  viewBox="0 0 100 10"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={zug} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      {/* Handlung im aufgeklappten Menue (29. September 2026, Alexander:
          „sieht sehr einfach aus"). Wer auf dem Handy das Menue oeffnet,
          sucht meist die Probestunde oder die Nummer — der rote Knopf der
          Leiste erscheint erst ab 1120 px. Aufbau wie im Hero: roter
          Knopf, darunter der Anruf. Ab 1120 px ausgeblendet. */}
      <div class="nav-handlung">
        <a class="nav-probe" href="/probestunde">Gratis-Probestunde</a>
        <a class="nav-telefon" data-kontakt={verschluesseln(telefon.href)}>
          <svg
            class="hoerer"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4 3h4l2 5-2.5 1.5a12.5 12.5 0 0 0 7 7L16 14l5 2v4h-1C11 20 4 13 4 4V3z"
            ></path>
          </svg>
          <span class="nur-vorlesen">Anrufen: </span>
          <Getarnt text={telefon.anzeige} />
        </a>
        <p class="nav-zeile">
          Gratis Beratung (<span data-erreichbar>Mo bis Fr 9–20 Uhr</span>)
        </p>
      </div>
    </nav>

    {/* Abdunklung der Seite hinter dem offenen Menue. Ein Tipp darauf
        schliesst es (Skript unten). */}
    <div class="abdunklung" data-abdunklung aria-hidden="true"></div>

    {/* Probestunde in der Leiste (29. September 2026). Die Leiste bleibt
        beim Scrollen stehen, der Knopf im Hero nicht — so ist die
        Hauptaktion auf der ganzen Seite eine Bewegung entfernt. Zugleich
        fuellt er die Luecke zwischen Navigation und Telefon, die leer
        wirkte (Alexander). Wie jeder Link auf /probestunde oeffnet er
        das Formularfenster (ProbestundeDialog). Erst ab 1120 px: darunter
        teilen sich Logo, Hoerer und Burger die Leiste. */}
    <a class="knopf-kopf" href="/probestunde">Gratis-Probestunde</a>

    {/* Kein aria-label mehr: Es stand im Klartext im HTML und damit
        jedem Adresssammler offen (Schutz siehe src/data/kontakt.ts).
        Der Name fuer Screenreader kommt jetzt aus dem Linktext —
        „Anrufen:" unsichtbar davor, die Nummer auf dem Handy nur
        optisch versteckt statt entfernt. */}
    {/* Aufbau nach dem Vorbild grosser Anbieter (Alexander,
        28. September 2026): Hoerer direkt vor der Nummer, beide gross,
        darunter mittig eine Zeile mit dem Grund zum Anrufen. „Gratis
        Beratung" ist Alexanders Formulierung. Auf dem Handy steht nur
        der Hoerer. */}
    <a class="kontakt" data-kontakt={verschluesseln(telefon.href)}>
      <span class="kontakt-oben">
        {/* Selbst gezeichnet, kein Icon-Paket. Flaechig seit dem
            25. September 2026 (vorher Umriss), Wunsch von Alexander.
            Die Kontur in derselben Farbe rundet die Ecken ab. Dieselbe
            Form steht im Anruf-Knopf der Preise. */}
        <svg
          class="hoerer"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M4 3h4l2 5-2.5 1.5a12.5 12.5 0 0 0 7 7L16 14l5 2v4h-1C11 20 4 13 4 4V3z"
          ></path>
        </svg>
        <span class="nur-vorlesen">Anrufen: </span>
        <span class="kontakt-nummer"
          ><Getarnt text={telefon.anzeige} /><svg
            class="zug"
            viewBox="0 0 100 10"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"><path d={zug}></path></svg
          ></span
        >
      </span>
      {/* Ohne Skript stehen die Wochentage da. Das Skript unten macht an
          Werktagen vor 20 Uhr „heute" daraus. */}
      <span class="kontakt-zeile"
        >Gratis Beratung (<span data-erreichbar>Mo bis Fr 9–20 Uhr</span>)</span
      >
    </a>

    {/* Neu gebaut am 29. September 2026: Bis dahin bestand das Symbol
        aus drei leeren <span> im Knopf, und Alexander sah es auf iPad
        und im Handy-Vorschaufenster gar nicht — das Menue war
        unauffindbar. Jetzt zwei gezeichnete Symbole (Striche und Kreuz),
        die das Skript nur umschaltet. Das Wort „Menü" darunter stand
        dort kurz und ist wieder raus (Alexander). */}
    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="hauptnav"
      aria-label="Menü öffnen"
      data-burger
    >
      <svg
        class="burger-symbol burger-auf"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
      <svg
        class="burger-symbol burger-zu"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>
  </div>
</header>

<script>
  // „heute" statt der Wochentage, solange heute noch jemand abnimmt:
  // Montag bis Freitag vor 20 Uhr, deutsche Zeit. Sonst bleibt „Mo bis
  // Fr 9–20 Uhr" stehen — lieber allgemein als falsch. Feiertage kennt
  // die Regel nicht.
  // Gilt fuer alle Stellen mit data-erreichbar (Kopfleiste, Preise).
  const erreichbar = document.querySelectorAll("[data-erreichbar]");
  if (erreichbar.length) {
    const teile = new Intl.DateTimeFormat("de-DE", {
      timeZone: "Europe/Berlin",
      weekday: "short",
      hour: "numeric",
      hourCycle: "h23",
    }).formatToParts(new Date());
    const tag = teile.find((t) => t.type === "weekday")?.value ?? "";
    const stunde = Number(teile.find((t) => t.type === "hour")?.value);
    if (!["Sa", "So"].includes(tag.replace(".", "")) && stunde < 20) {
      erreichbar.forEach((e) => (e.textContent = "heute 9–20 Uhr"));
    }
  }

  const leiste = document.querySelector("[data-leiste]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const nav = document.getElementById("hauptnav");
  const abdunklung = document.querySelector("[data-abdunklung]");

  if (leiste && burger && nav) {
    // tastatur: Nur wer das Menue mit der Tastatur oeffnet, bekommt den
    // Fokus auf den ersten Link. Beim Antippen stand sonst ein Fokusring
    // um „Fächer", der wie ein Fehler aussah.
    const setzen = (offen: boolean, tastatur = false) => {
      leiste.classList.toggle("offen", offen);
      burger.setAttribute("aria-expanded", String(offen));
      burger.setAttribute(
        "aria-label",
        offen ? "Menü schließen" : "Menü öffnen",
      );
      if (offen && tastatur) nav.querySelector<HTMLAnchorElement>("a")?.focus();
    };

    // detail === 0: Der Klick kam von Enter oder Leertaste, nicht vom
    // Zeiger.
    burger.addEventListener("click", (e) => {
      setzen(burger.getAttribute("aria-expanded") !== "true", e.detail === 0);
    });

    // closest statt instanceof: Der Tipp landet oft auf dem Text im
    // Link, nicht auf dem Link selbst.
    nav.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a")) setzen(false);
    });

    abdunklung?.addEventListener("click", () => setzen(false));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && leiste.classList.contains("offen")) {
        setzen(false);
        burger.focus();
      }
    });

    // Beim Wechsel in die zweispaltige Ansicht ist der Burger weg —
    // dann darf kein offener Zustand zurückbleiben.
    matchMedia("(min-width: 1120px)").addEventListener("change", (e) => {
      if (e.matches) setzen(false);
    });
  }
</script>

<style>
  .leiste {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--color-action);
    color: var(--color-text-on-action);
  }

  .raster {
    width: 100%;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
    height: var(--layout-header-height);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Logo ------------------------------------------------------------
     CSS-Nachbau, Maßverhältnisse aus public/bilder/logo.svg. Alle Werte
     sind Bruchteile der Blockbreite --logo-b; der Block trägt
     font-size: var(--logo-b), dadurch ist 1em = Blockbreite.

     Der Block trägt die Markenfarbe (Rot), die Leiste die Aktionsfarbe
     (Blau). Zusammen mit Rundung und Schatten setzt er sich damit als
     eigene Fläche ab, statt in der Leiste zu verschwinden. */
  .logo {
    /* Blockbreite des Logos. Alles darin ist ein Bruchteil davon, der
       Nachbau skaliert also proportional mit — Schriftzug, Claim,
       Innenabstaende, Rundung.

       Am 2. September 2026 um ein Vierzehntel verkleinert (180/210/240
       vorher), weil das Logo neben der Navigation zu schwer stand. Die
       drei Stufen behalten ihr Verhaeltnis zueinander. */
    --logo-b: 168px;
    align-self: flex-start;
    position: relative;
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    box-sizing: border-box;
    flex: none;
    width: var(--logo-b);
    font-size: var(--logo-b);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
    /* Nur unten gerundet. Die Oberkante liegt buendig auf der
       Oberkante der Leiste — eine Rundung dort saehe aus wie ein
       Fehler, nicht wie eine Kante. */
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-family-logo);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    /* Die vier Innenabstaende stammen aus public/bilder/logo.svg.
       --logo-luft kommt oben und unten zusaetzlich dazu und ist der
       einzige Wert, den man zum Nachjustieren anfassen muss. Bei 0
       entspricht der Block exakt dem SVG. */
    --logo-luft: 0.016em;
    padding: calc(0.0279em + var(--logo-luft)) 0.0621em
      calc(0.0481em + var(--logo-luft)) 0.0571em;
    gap: 0.01157em;
  }

  .logo-wort {
    font-size: 0.18691em;
    letter-spacing: -0.02em;
  }

  .logo-claim {
    font-size: 0.06765em;
    letter-spacing: -0.033em;
    word-spacing: 0.0103em;
  }

  /* Navigation ------------------------------------------------------ */

  .nav {
    display: none;
  }

  .nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Nur im aufgeklappten Menue (unter 1120 px), siehe dort. */
  .nav-handlung,
  .abdunklung {
    display: none;
  }

  /* Links ------------------------------------------------------------
     Am 28. September 2026 ruhiger gemacht (Alexander: „wirkt wie ein
     WordPress-Widget"). Vorher kursiv und halbfett, beim Ueberfahren
     unterstrichen. Jetzt aufrecht, ohne Unterstreichung; beim
     Ueberfahren zieht sich darunter derselbe weisse Markerzug wie unter
     den Ueberschriften der Seite — die Handschrift der Marke statt der
     Standard-Unterstreichung des Browsers.

     --zug-dicke, --zug-abstand: Geometrie der Zeichnung. */
  .nav a {
    --zug-dicke: 3px;
    --zug-abstand: -0.35em;

    position: relative;
    display: inline-block;
    color: var(--color-text-on-action);
    text-decoration: none;
    font-weight: var(--font-weight-semibold);
  }

  .zug {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--zug-abstand);
    width: 100%;
    height: 0.3em;
    overflow: visible;
    pointer-events: none;
    clip-path: inset(-50% 100% -50% 0);
  }

  .zug path {
    fill: none;
    stroke: var(--color-text-on-action);
    stroke-width: var(--zug-dicke);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .nav a:hover .zug,
  .nav a:focus-visible .zug,
  .kontakt:hover .zug,
  .kontakt:focus-visible .zug {
    clip-path: inset(-50% 0 -50% 0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .zug {
      transition: clip-path 200ms ease-out;
    }
  }

  .nav a:active {
    opacity: 0.75;
  }

  /* Kontakt --------------------------------------------------------- */

  /* Mindestens 44 x 44 px Tippflaeche (WCAG 2.2, Target Size). Auf dem
     Handy steht nur der Hoerer da, 22 px — ohne Mindestgroesse war der
     wichtigste Knopf der Seite das kleinste Tippziel (gemessen am
     25. September 2026). */
  .kontakt {
    margin-left: auto;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: var(--tap-target-min);
    min-height: var(--tap-target-min);
    color: var(--color-text-on-action);
    text-decoration: none;
    flex: none;
  }

  .kontakt-oben {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hoerer {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    flex: none;
  }

  /* Fuer Screenreader da, fuers Auge nicht. Die uebliche Technik: auf
     einen Pixel zusammengezogen und weggeschnitten. display: none oder
     visibility: hidden wuerden den Text auch aus dem Vorlesen nehmen.
     Auf dem Handy gilt das fuer Nummer und Zeile: Dort steht nur der
     Hoerer. */
  .nur-vorlesen,
  .kontakt-nummer,
  .kontakt-zeile {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Fett und kursiv (28. September 2026, Alexander: die aufrechten
     Ziffern wirkten „zu mechanisch, wie aus dem Textprogramm"). Echter
     Kursivschnitt der Source Sans 3, siehe @font-face im BaseLayout.
     Beim Ueberfahren derselbe Markerzug wie unter den Links — die
     Unterstreichung des Browsers war an den Stoerzeichen der Tarnung
     unterbrochen und sah gestrichelt aus. Der Zug sitzt knapp unter
     den Ziffern (keine Unterlaengen), damit er die Zeile darunter nicht
     streift. */
  .kontakt-nummer {
    --zug-dicke: 3px;
    --zug-abstand: -0.1em;

    font-size: var(--font-size-lg);
    font-style: italic;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
  }

  /* Mittig unter Hoerer und Nummer, kursiv wie die Nummer.
     Weiss auf dem Blau der Leiste: 8,1:1. */
  .kontakt-zeile {
    font-size: var(--font-size-sm);
    font-style: italic;
    line-height: var(--line-height-normal);
  }

  /* Probestunde ------------------------------------------------------
     Derselbe Knopf wie im Hero (Markenrot, fett, kursiv), eine Stufe
     kleiner, damit er in die 64 px der Leiste passt. Schatten wie am
     Logo: Beide roten Flaechen liegen auf dem Blau. */
  .knopf-kopf {
    display: none;
    flex: none;
    align-items: center;
    min-height: var(--tap-target-min);
    padding: 0 var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
    box-shadow: var(--shadow-sm);
    font-style: italic;
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    white-space: nowrap;
  }

  .knopf-kopf:hover {
    background: var(--color-brand-strong);
  }

  .knopf-kopf:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  /* Burger ---------------------------------------------------------- */

  /* 44 px ist die Untergrenze fuer Tippziele aus WCAG 2.2. Das Symbol ist
     weiss auf der Leiste.

     appearance: none und die ausdrueckliche Farbe: Safari gibt Knoepfen
     sonst eigene Vorgaben mit (Farbe, Innenabstand). Die Symbole sind
     gezeichnet (stroke: currentColor) und haben feste Masse — sie
     haengen nicht mehr davon ab, wie ein Browser leere Elemente in
     einem Knopf streckt.

     --burger-versatz: Geometrie. Er rueckt das Symbol optisch an die
     Kante des Rasters, die Trefferflaeche reicht darueber hinaus. */
  .burger {
    --burger-versatz: 6px;

    appearance: none;
    flex: none;
    min-width: var(--tap-target-min);
    min-height: var(--tap-target-min);
    margin-right: calc(-1 * var(--burger-versatz));
    padding: 0 var(--burger-versatz);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    background: none;
    border: 0;
    color: var(--color-text-on-action);
    font: inherit;
    cursor: pointer;
  }

  .burger-symbol {
    display: block;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .burger-zu,
  .leiste.offen .burger-auf {
    display: none;
  }

  .leiste.offen .burger-zu {
    display: block;
  }


  /* Fokus ------------------------------------------------------------ */

  .logo:focus-visible,
  .nav a:focus-visible,
  .knopf-kopf:focus-visible,
  .kontakt:focus-visible,
  .burger:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  /* Aufgeklapptes Menue (unter 1120 px) -----------------------------------
     Neu am 29. September 2026 (Alexander: „sieht sehr einfach aus", „viel
     kontrastreicher"). Vorher drei weisse Links auf dunklerem Blau, direkt
     unter dem Logo.

     Jetzt eine weisse Flaeche mit dunkler Schrift — die kontrastreichste
     Paarung der Seite (15,9:1) und klar abgesetzt von der blauen Leiste
     und dem dunklen Hero. Die Links sind grosse Zeilen ueber die volle
     Breite, getrennt durch Linien: jede Zeile ein Tippziel. Ohne Pfeil
     am Ende (Alexander): Ein Pfeil verspricht ein Untermenue, das es
     nicht gibt. Darunter die Handlung wie im Hero, rot und blau. Die Seite
     dahinter wird abgedunkelt und scrollt nicht mit.

     padding-top: Der rote Logoblock ragt unter die Leiste (auf dem
     Handy rund 11 px, auf dem Tablet rund 15 px). --space-8 haelt den
     ersten Link frei davon. */
  @media (max-width: 1119px) {
    .leiste.offen .nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 1;
      max-height: calc(100dvh - var(--layout-header-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-8) var(--layout-gutter) var(--space-8);
      background: var(--color-surface-inverse);
      color: var(--color-text-inverse);
      box-shadow: var(--shadow-md);
    }

    .nav ul,
    .nav-handlung {
      max-width: var(--measure-default);
      margin-inline: auto;
    }

    .nav li + li {
      border-top: 1px solid var(--color-border-inverse-subtle);
    }

    .nav li a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      min-height: var(--tap-target-min);
      padding: var(--space-4) 0;
      color: var(--color-text-inverse);
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height-tight);
    }

    /* Kein Markerzug im Menue: Er gehoert zum Ueberfahren mit der Maus,
       und hier tippt man. */
    .nav li a .zug {
      display: none;
    }

    .nav li a:focus-visible {
      outline-color: var(--color-focus-ring-inverse);
    }

    .nav-handlung {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-top: var(--space-6);
    }

    /* .nav davor: Die Grundregel .nav a (fuer die Links der Leiste)
       waere sonst staerker. */
    .nav .nav-probe,
    .nav .nav-telefon {
      display: flex;
      align-items: center;
