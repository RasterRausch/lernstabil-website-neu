---
// Sektion: Was machen wir anders (Startseite, 3)
//
// Aufbau und Text stammen urspruenglich von der bestehenden Seite
// lernstabil.de, der Hintergrund ist weiss statt hellgrau.
//
// Ueberarbeitet am 25. September 2026. Alexanders Kritik: zu leise,
// zu klein, „nicht zu langweilig wie es jetzt ist". Die Sektion
// bekommt dieselben Mittel wie die Preise:
//
// - Die Punkte werden abgehakt statt aufgezaehlt: dicke rote
//   Marker-Haken, gezogen von der Doodly-Hand (scripts/doodle-hand.ts).
// - Punkt-Ueberschriften in der Displayschrift und in xl — vorher
//   md, kleiner als die H3 in Sektion 4.
// - Der Junge steht auf der Unterkante der Sektion und wird von der
//   dunklen Sektion darunter angeschnitten, wie die Schuelerin im
//   Hero. Vorher schwebte er mitten auf der Flaeche und wirkte
//   abgeschnitten.
// - Knopf rot statt blau: Die Probestunde ist auf der ganzen Seite
//   rot (Hero, Preise), Blau gehoert dem Telefon.
//
// Die Texte der Punkte sind neu geschrieben, ohne neue Behauptungen:
// Einzelunterricht, Mut, Grundlagen, online und persoenlich standen
// schon vorher da.

import Unterstrichen from "../Unterstrichen.astro";

const vorzeile = "Was machen wir anders";

const punkte = [
  {
    titel: "Einzelunterricht. Punkt.",
    text: "Ein Dozent, ein Schüler, die ganze Stunde. Wir fangen dort an, wo Ihr Kind gerade steht, und nehmen jede spontane Frage mit.",
  },
  {
    titel: "Mehr Selbstvertrauen",
    text: "Wer versteht, traut sich. Wir erklären, bis es sitzt – und dann traut sich Ihr Kind auch an die nächste Aufgabe.",
  },
  {
    titel: "Erst das Fundament, dann die Kür",
    text: "Ob Mathe, Deutsch, Englisch oder Latein: Alte Lücken schließen wir zuerst. Dann klappen auch die kniffligen Themen.",
  },
  {
    titel: "100 % online, 100 % persönlich",
    text: "Wir setzen auf echten Austausch, persönliche Betreuung und ein Lernklima, das auch digital Nähe schafft.",
  },
];

// Gezeichnete Linien, viewBox-Koordinaten. Der Haken reicht ueber die
// volle Breite (0 bis 30), damit das Aufdecken von links genau mit der
// Stiftspitze mitlaeuft. Knick bei x = 9 — der kurze Schenkel zuerst,
// wie man einen Haken von Hand zieht.
const haken = "M0 12 C 3 14, 6 17, 9 21 C 14 12, 21 6, 30 1";
---

<section class="anders" aria-labelledby="anders-titel">
  <div class="wrap">
    <div class="kopf">
      <p class="vorzeile">{vorzeile}</p>
      <h2 id="anders-titel">
        <Unterstrichen>Echte Förderung</Unterstrichen>{" "}statt{" "}
        <span class="zusammen">Franchise-Fließband</span>
      </h2>
      <p class="einleitung">
        Bei <strong class="marke">#Lernstabil</strong> gibt es keine versteckten Kosten, kein
        unpersönliches Franchise-Modell und keine standardisierten
        Unterrichtspakete. Jeder Schüler lernt anders – und genau darauf gehen
        wir ein.
      </p>
    </div>

    <div class="spalten">
      <div class="inhalt">
        <ul class="punkte">
          {
            punkte.map((p) => (
              <li>
                <svg
                  class="haken"
                  viewBox="0 0 30 24"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={haken} />
                </svg>
                <h3>{p.titel}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>

        <a class="knopf" href="#probestunde">Gratis Probestunde sichern</a>

        {
          /* Doodly-Hand, dieselbe wie in Sektion 7. Rein dekorativ; das
             Skript unten bewegt sie, ohne Skript bleibt sie unsichtbar. */
        }
        <img
          class="hand"
          src="/bilder/hand-marker.webp"
          width="520"
          height="550"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="bild">
        {
          /* Freigestelltes Motiv mit Alphakanal, erzeugt mit Firefly,
             neu in hoeherer Aufloesung am 25. September 2026
             (Vorlage 1176 x 2192, ausgeliefert 800 x 1491). Die
             Unterkante ist eine gerade Schnittkante durch den Pullover —
             sie sitzt auf der Sektionskante.

             alt="" wie beim Hero: Das Bild traegt Stimmung, keine
             Information. Erzeugte Person, kein echter Schueler. */
        }
        <img
          src="/bilder/schueler-sektion-3.webp"
          width="800"
          height="1491"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // Die Hand hakt die Punkte ab, einmal beim ersten Hineinscrollen.
  // Ablauf, Zeiten und Regeln fuer reduzierte Bewegung:
  // scripts/doodle-hand.ts.
  import { hakenAbhaken } from "../../scripts/doodle-hand";

  const bereich = document.querySelector<HTMLElement>(".anders .inhalt");
  if (bereich) hakenAbhaken(bereich);
</script>

<style>
  /* ------------------------------------------------------------------
     DER KEIL — nur diesen Wert anfassen.

     --keil-h  Wie tief der Keil ist. Gemessen von der Oberkante der
               Flaeche an den beiden Seiten bis zu ihrer tiefsten Stelle
               in der Mitte. 0 = gerade Kante.

     ACHTUNG: Der Keil traegt jetzt die WEISSE Flaeche dieser Sektion,
     nicht mehr Rot. Er schneidet damit hell in die dunkle
     Vertrauensleiste darueber. Das ist die Folge davon, dass der
     Hintergrund weiss wurde — siehe spec.md.
     ------------------------------------------------------------------ */
  .anders {
    --keil-h: 24px;

    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);

    margin-top: calc(-1 * var(--keil-h));
    clip-path: polygon(0 0, 50% var(--keil-h), 100% 0, 100% 100%, 0 100%);
    padding: calc(var(--space-18) + var(--keil-h)) 0 var(--space-18);
    /* Die Hand der Haken-Animation kommt von rechts ausserhalb herein.
       clip-path schneidet sie zwar optisch ab, zaehlt aber nicht fuer
       das Scrollen — ohne overflow-x entstuende waehrenddessen eine
       waagerechte Scrollleiste. clip statt hidden: kein
       Scrollcontainer, die sticky Kopfleiste bleibt unberuehrt. */
    overflow-x: clip;
  }

  .wrap {
    width: 100%;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  /* Kopf — mittig, wie in der Vorlage ---------------------------------- */

  .kopf {
    text-align: center;
  }

  .vorzeile {
    margin: 0;
    color: var(--color-action);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-relaxed);
  }

  h2 {
    margin: var(--space-2) auto 0;
    /* 28ch statt der frueheren 22: Alexander fand den Kopf am
       2. September 2026 zu schmal fuer die Seitenbreite. Der Umbruch
       bleibt zweizeilig, die Zeilen werden nur laenger. In ch, waechst
       also mit der Schriftgroesse mit. */
    max-width: 28ch;
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  .haken path {
    fill: none;
    stroke: var(--color-brand);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .einleitung {
    margin: var(--space-6) auto 0;
    max-width: var(--measure-wide);
    color: var(--color-text-inverse-subtle);
  }

  /* Die Marke ist in der Vorlage rot hervorgehoben. Rot als Schrift ist
     im Projekt sonst ausgeschlossen, weil es auf dunklem Grund nur
     3,05:1 erreicht. HIER ist der Grund weiss: #d00000 auf Weiss ergibt
     5,70:1 und ist damit sauber. Die Regel gilt also weiterhin — sie
     bezieht sich auf dunkle Flaechen. */
  .einleitung strong {
    color: var(--color-brand);
    font-weight: var(--font-weight-bold);
  }

  /* Spalten ------------------------------------------------------------
     Unter 1120 px: erst Text und Knopf, dann der Junge, der auf der
     Unterkante steht. Er kommt im Quelltext nach dem Text, damit die
     Lesereihenfolge dieselbe ist wie die sichtbare. */

  .spalten {
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* Der Junge steht auf der Sektionskante: Der negative Rand hebt den
     unteren Innenabstand der Sektion fuer diese Spalte auf. Die gerade
     Schnittkante des Bildes faellt damit genau auf die Kante zur
     dunklen Sektion darunter. */
  .bild {
    margin-bottom: calc(-1 * var(--space-18));
  }

  /* Freigestelltes Motiv: kein Rahmen, keine Rundung, kein Schatten.
     Es steht auf der Flaeche, es liegt nicht darauf.

     --motiv-breite: Auf dem Handy schmaler als die Spalte und mittig,
     sonst waere er allein hoeher als der Bildschirm. */
  .bild img {
    --motiv-breite: 280px;

    display: block;
    width: 100%;
    max-width: var(--motiv-breite);
    height: auto;
    margin: 0 auto;
  }

  /* Punkte -------------------------------------------------------------
     Haken links, Ueberschrift und Text daneben. Der Haken ist eine
     Zeichnung wie der Strich in Sektion 7: dicker roter Markerzug, von
     Hand gezogen.

     --haken-breite, --haken-hoehe, --haken-dicke, --haken-oben:
     Geometrie der Zeichnung. --haken-oben setzt den Haken auf die erste
     Zeile der Ueberschrift (26 px Schrift, Zeilenhoehe 1,15 = rund
     30 px; der Haken ist 26 px hoch). */
  .punkte {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .punkte li {
    --haken-breite: 32px;
    --haken-hoehe: 26px;
    --haken-dicke: 5px;
    --haken-oben: 2px;

    display: grid;
    grid-template-columns: var(--haken-breite) 1fr;
    column-gap: var(--space-4);
  }

  .haken {
    grid-row: span 2;
    width: var(--haken-breite);
    height: var(--haken-hoehe);
    margin-top: var(--haken-oben);
    overflow: visible;
  }

  .haken path {
    stroke-width: var(--haken-dicke);
  }

  /* Ohne Skript und bei abbestellter Bewegung stehen die Haken einfach
     da. Das Skript setzt .animiert nur, wenn es laufen darf; erst dann
     sind die Haken verdeckt, bis die Hand sie zieht. */
  .punkte.animiert .haken {
    clip-path: inset(-6px 100% -6px 0);
  }

  /* In der Displayschrift und in xl — groesser als die H3 in Sektion 4
     (lg). Die Punkte sind hier die Aussage der Sektion, nicht
     Beiwerk zum Bild. */
  .punkte h3 {
    margin: 0;
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  .punkte p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-inverse-subtle);
  }

  /* Die Hand ------------------------------------------------------------
     Wie in Sektion 7: links oben im Bereich verankert, das Skript
     verschiebt sie. Der Aermel wird schraeg quer zum Arm abgeschnitten
     statt an der rechtwinkligen Bildkante — Werte und Begruendung
     stehen an der Hand in Sektion 7 (Preise.astro). */
  .inhalt {
    position: relative;
  }

  .hand {
    --hand-breite: 200px;
    --schnitt-winkel: 150deg;
    --schnitt: 85%;
    --schnitt-weich: 0%;

    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: var(--hand-breite);
    height: auto;
    max-width: none;
    pointer-events: none;
    visibility: hidden;
    mask-image: linear-gradient(
      var(--schnitt-winkel),
      #000 calc(var(--schnitt) - var(--schnitt-weich)),
      transparent var(--schnitt)
    );
  }

  /* Knopf --------------------------------------------------------------
     Rot wie „Jetzt gratis testen" im Hero und die Probestunde in
     Sektion 7. Weiss auf --color-brand 5,70:1. */
  .knopf {
    margin-top: var(--space-12);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target-min);
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    text-align: center;
    text-decoration: none;
  }

  .knopf:hover {
    background: var(--color-brand-strong);
  }

  .knopf:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  /* Der Fokusring des Projekts ist weiss — auf dieser hellen Flaeche
     waere er unsichtbar. Hier traegt ihn der dunkle Text. */
  .knopf:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-text-inverse);
    outline-offset: var(--focus-ring-offset);
  }

  /* ab 768 -------------------------------------------------------------- */

  @media (min-width: 768px) {
    .anders {
      --keil-h: 48px;
    }

    /* Ab 768 px passt „Franchise-Fließband" in eine Zeile und soll
       nicht am Bindestrich brechen. Darunter ist das Wort bei 52 px
       breiter als der Bildschirm und muss brechen duerfen. */
    .zusammen {
      white-space: nowrap;
    }

    .bild img {
      --motiv-breite: 340px;
    }

    .hand {
      --hand-breite: 260px;
    }
  }

  /* ab 1120 — zweispaltig ------------------------------------------------ */

  @media (min-width: 1120px) {
    .anders {
      --keil-h: 72px;
      padding-top: calc(var(--space-18) + var(--keil-h));
      padding-bottom: var(--space-18);
    }

    /* Der Junge links, wie bisher. order statt Quelltext-Reihenfolge:
       Im Quelltext steht der Text vorn, damit er auf dem Handy zuerst
       kommt. */
    .spalten {
      flex-direction: row;
      gap: var(--space-18);
    }

    /* Der Kopf des Jungen reicht nach oben bis auf Hoehe der
       Einleitung, wie von Alexander am 25. September 2026
       eingezeichnet. Der negative Rand oben zieht das Bild ueber den
       Abstand zwischen Einleitung und Spalten hinaus; die Einleitung
       steht mittig und schmal, links daneben ist die Flaeche frei.
       Ohne ihn wuerde das groessere Bild die Sektion nur nach unten
       verlaengern. */
    .bild {
      --motiv-hoch: calc(var(--space-12) + var(--space-18));

      order: -1;
      flex: 0 0 auto;
      align-self: flex-end;
      margin-top: calc(-1 * var(--motiv-hoch));
    }

    /* 430 px breit ergibt mit dem Hochformat (800 x 1491) rund 800 px
       Hoehe: von der Einleitung bis zur Sektionskante. Am
       25. September 2026 von 390 angehoben, Alexander wollte ihn
       groesser. Die Vorlage hat 1176 px, also bleibt er auch auf
       Retina-Bildschirmen scharf. */
    .bild img {
      --motiv-breite: 430px;

      margin: 0;
    }

    .inhalt {
      flex: 1 1 auto;
      align-self: center;
      display: flex;
      flex-direction: column;
    }
  }
</style>
