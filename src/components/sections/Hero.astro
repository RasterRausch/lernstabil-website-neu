---
import { haken } from "../../data/zeichnungen";
import Unterstrichen from "../Unterstrichen.astro";
import Beratung from "../Beratung.astro";
// Sektion: Hero (Startseite, 1)

// Siegel von Trustindex, aus Alexanders Konto.
//
// Am 1. September 2026 stand hier schon einmal ein drittes Siegel: das
// Zertifikat „Aussergewoehnlicher Kundenservice", als Bild statt als
// Widget, weil `loader-cert.js` an die Domain gebunden ist und auf
// jeder Adresse ausser lernstabil.de nur die Meldung „Trustmark widget
// validation failed" zeigt. Alexander hat es am selben Tag wieder
// entfernt. Seit dem Livegang (29. September 2026) steht es als Widget
// neben den Karten.
// Punkte im Hero. Haken im Stil der Sektionen 3 und 5 (Marker-Haken,
// viewBox 0 0 30 24), hier weiss. Seit dem 25. September 2026 —
// vorher dünne CSS-Häkchen, die nicht zum Rest passten.
const punkte = [
  "Individueller Einzelunterricht",
  "Volle Flexibilität (Fächerwechsel)",
  // Ohne Smartphone, wie in Sektion 5 — Vorgabe von Alexander am
  // 25. September 2026.
  "Einfach per PC, Laptop oder Tablet",
];

// Google zuerst (Alexander, 29. September 2026): die bekanntere Marke
// vorn. Vorher stand Trustindex links.
// Zertifikat, seit 29. September 2026 wieder drin (siehe Markup).
const zertifikat = "3bfd6d6807be50304926958dc7a";

const siegel = [
  { id: "d7ec3be801f95047135619f0996", quelle: "Google" },
  { id: "67c6a0b8012c503e17061c29e56", quelle: "Trustindex" },
];
---

<section class="hero" aria-labelledby="hero-titel">
  <div class="wrap">
    <div class="inhalt">
      <div class="text">
        {
          /* Beide Zeilen gehoeren in die H1. Zusammengelesen ergeben
             sie die Kernaussage der Seite — genau das soll die
             Ueberschrift transportieren, auch fuer Screenreader und
             Suchmaschinen. Die Spans tragen nur die zwei
             Schriftgroessen; sie erzeugen keine eigene Gliederungsebene
             und sind semantisch unauffaellig. Die Alternative waere
             <hgroup> mit H1 und <p>; sie wurde verworfen, weil dabei
             das Versprechen aus der H1 herausfaellt. */
        }
        <h1 id="hero-titel">
          <span class="zeile1">ONLINE NACHHILFE</span>
          {
            /* <em> statt <i>: Die Vertragsfreiheit ist der Markenkern,
               die Betonung ist echt und nicht bloss typografisch.
               Screenreader heben <em> leicht hervor, <i> nicht. */
          }
          {
            /* „Einzelunterricht" mit dem roten Markerzug der
               Sektionsueberschriften (Alexander, 28. September 2026). */
          }
          <span class="zeile2"
            ><em
              ><Unterstrichen>Einzelunterricht</Unterstrichen>, <strong
                >ohne Vertragslaufzeit</strong
              > und <strong>ohne Kleingedrucktes</strong>.</em
            ></span
          >
        </h1>

        {
          /* „Nachhilfe, die ankommt" stand hier bis zum 2. September
             2026. Das Wortspiel — ankommen im Sinn von gut ankommen und
             im Sinn von wirklich beim Schueler ankommen — loest sich
             nicht ein, solange der Satz nicht sagt, WAS ankommt. Der
             Nachsatz nennt jetzt den Gegenentwurf: nicht der schnelle
             Rettungsring vor der naechsten Arbeit, sondern Stoff, der
             haelt. Das ist dieselbe Haltung wie in Sektion 3
             („Echte Foerderung statt Franchise-Fliessband"). */
        }
        <p class="unterzeile">
          <strong>Profi-Nachhilfe</strong>, die ankommt. Wir erklären, bis es
          wirklich sitzt.
        </p>

        {
          /* Drei Punkte, drei verschiedene Einwaende: Bekommt mein Kind
             genug Aufmerksamkeit? Bin ich festgelegt? Brauche ich
             Technik dafuer?

             Der erste Punkt hiess „Die ganze Stunde gehoert dem
             Schueler" — richtig gemeint, aber er klang nach
             Zeitabrechnung statt nach Zuwendung. Der zweite nannte
             „Volle Flexibilitaet (Faecherwechsel, Unterrichtszeiten)":
             eine Behauptung mit Klammer dahinter. Jetzt steht dort die
             Sache selbst, und die Unterrichtszeiten sind draussen —
             sie stehen ohnehin unter den Knoepfen. */
        }
        <ul class="punkte">
          {
            punkte.map((p) => (
              <li>
                <svg
                  class="haken"
                  viewBox="0 0 30 24"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={haken} />
                </svg>
                {p}
              </li>
            ))
          }
        </ul>

        {
          /* Ein Knopf, darunter der Anruf als Zeile — Aufbau nach dem
             Vorbild grosser Anbieter (Alexander, 28. September 2026).
             Bis dahin standen hier zwei gleich grosse Knoepfe, Telefon
             blau und Probestunde rot, darunter „Mo bis Fr, 9 bis 20 Uhr".
             Die Zeiten stehen jetzt in der Kopfleiste.

             Bis zum 29. September 2026 stand unter der Beratung „Die
             Gratis-Probestunde dauert 45 Minuten und dient zugleich als
             Leistungsanalyse.", zuletzt als Fussnote zu einem Sternchen am
             Knopf. Entfernt (Alexander): Die Seite verspricht „ohne
             Kleingedrucktes", ein Sternchen ist das typische Zeichen dafuer.
             Der Satz steht jetzt einmal im Formular neben „Weiter", Dauer
             und Leistungsanalyse nennen auch die Fragen (Sektion 8).
             Dasselbe an allen Probestunden-Knoepfen der Seite; keine
             Sternchen-Fussnoten mehr.

             Die Siegel stehen unter Knopf und Beratung und ragen in den
             Sockel (Alexander, 29. September 2026). Die Geschichte der
             Anordnung steht am CSS ab 768 px (zweispaltig). */
        }
        <div class="handlung">
          <div class="aufruf">
            <div class="aktionen">
              <a
                class="knopf-probe"
                href="/probestunde"
                >Jetzt gratis testen</a
              >
            </div>

            <Beratung />
          </div>

          {
            /* Siegel. Wie die Widgets in der Vertrauensleiste laden sie
               asynchron von cdn.trustindex.io und bringen ihr eigenes CSS
               mit; wir ruehren es nicht an und steuern nur die Flaeche.

               is:inline ist Pflicht: ohne das Attribut zieht Astro das
               Script ins eigene Bundle und der Loader verliert die
               Stelle, an der er das Siegel einsetzt. */
          }
          <div class="siegel">
            {
              siegel.map((s) => (
                <div class="siegel-widget">
                  <script
                    defer
                    async
                    is:inline
                    src={`https://cdn.trustindex.io/loader.js?${s.id}`}
                  />
                </div>
              ))
            }
            {/* Zertifikat „Außergewöhnlicher Kundenservice" (Alexander,
                29. September 2026). loader-cert.js ist an die Domain
                gebunden: Auf jeder Adresse ausser lernstabil.de, also
                auch lokal, zeigt es nur „Trustmark widget validation
                failed". Pruefen deshalb nur live. */}
            <div class="siegel-zertifikat">
              <script
                defer
                async
                is:inline
                src={`https://cdn.trustindex.io/loader-cert.js?${zertifikat}`}
              />
            </div>
          </div>
        </div>
      </div>

      <div class="motiv">
        {
          /* Freigestellt mit Alphakanal, deshalb kein Blend-Modus.
             Erzeugte Person, auf dunklem Grund freigestellt.

             Bis zum 28. September 2026 ein PNG mit 4,9 MB. Jetzt WebP in
             vier Breiten (94 / 190 / 284 / 512 KB), erzeugt mit
             cwebp -q 82 -alpha_q 100 -resize.

             Seit 29. September 2026 haelt sie einen korrigierten
             Englischtest (Photoshop, Quelle vorlagen/hero-schuelerin-test-2.png,
             nicht im Repo). Der Name „Lena" und die Note darauf sind
             Requisite: nirgends auf der Seite als echter Fall ausgeben,
             auch nicht im alt-Text. Die 1200er-Stufe fuer
             Handys mit hoher Pixeldichte (rund 1070 Bildpunkte), die
             sonst die grosse Datei geladen haetten. sizes: Unter 768 px geht
             das Motiv ueber die volle Breite. Von 768 bis 1119 px ist es
             180 % der rechten Spalte breit, rund 71 bis 73 % des Fensters
             (gerechnet: 0,45 x 1,8 x (Fenster - 96)), angesetzt mit 75vw.
             Ab 1120 px rund 780 px (Hoehe der Spalte mal
             Seitenverhaeltnis). */
        }
        <img
          src="/bilder/hero-schuelerin-1494.webp"
          srcset="/bilder/hero-schuelerin-640.webp 640w, /bilder/hero-schuelerin-960.webp 960w, /bilder/hero-schuelerin-1200.webp 1200w, /bilder/hero-schuelerin-1494.webp 1494w"
          sizes="(min-width: 1120px) 780px, (min-width: 768px) 75vw, 100vw"
          width="1494"
          height="1628"
          alt=""
          fetchpriority="high"
        />

        {
          /* Stempel. Bewusst KEIN Pruefsiegel: kein Kranz, keine
             Sterne, keine Pruefsprache („geprueft", „zertifiziert",
             „ausgezeichnet"). Der Satz ist eine Aussage ueber uns
             selbst und eine nachpruefbare Tatsache — seit 2021 wird
             online unterrichtet, dieselbe Zahl steht in der
             Vertrauensleiste.

             Das ist der Unterschied, an dem das Wettbewerbsrecht
             haengt: Eigenwerbung ist erlaubt, der Anschein einer
             Bestaetigung durch Dritte nicht. Deshalb steht der Stempel
             auch am Motiv und nicht bei den Trustindex-Siegeln, wo er
             als drittes Fremdsiegel gelesen wuerde.

             Ein <p> statt eines Bildes: Der Satz wird vorgelesen und
             mitgesucht, er skaliert mit der Schriftgroesse und kostet
             keinen Ladevorgang. */
        }
        <p class="stempel">
          <span class="stempel-satz">Qualifizierte Nachhilfe seit</span>
          <span class="stempel-jahr">2021</span>
        </p>
      </div>
    </div>
  </div>
  {/* Roter Sockel als Abschlusskante. Rein dekorativ, ohne Inhalt. */}
  <div class="sockel"></div>
</section>

<style>
  .hero {
    /* Hoehe des roten Sockels am unteren Rand. Steht hier, weil die
       Mindesthoehe damit rechnet. */
    --sockel-h: var(--space-12);

    /* Die Kopfleiste steht im Fluss und belegt Platz. Zusammen ergeben
       Leiste und Hero 75 % der Bildschirmhöhe. Der Sockel kommt darunter
       DAZU, statt dem Inhalt Hoehe wegzunehmen — sonst schrumpft die
       Motivspalte und das Bild wird frueher angeschnitten. */
    min-height: calc(75svh - var(--layout-header-height) + var(--sockel-h));
    display: flex;
    flex-direction: column;
    overflow: hidden;

    /* Lichtkegel hinter dem Motiv, nachgebaut nach dem Studiolicht im
       Originalfoto: heller Bereich hinter Kopf und Schultern, nach
       aussen abfallend. Der Kegel wandert mit dem Motiv: unter 768 px
       steht es unten, deshalb --licht-y: 72% — dort liegt der Kopf.
       Ab 768 px steht es rechts.

       --licht-staerke: 0.075 ist die Obergrenze. Die Freistellung ist
       auf dunklem Grund entstanden, halbtransparente Haarpixel tragen
       Restdunkel. Deutlich heller, und um die Haare zeichnet sich ein
       Saum ab. */
    --licht-x: 50%;
    --licht-y: 72%;
    --licht-b: 90%;
    --licht-h: 55%;
    --licht-staerke: 0.075;

    background:
      radial-gradient(
        ellipse var(--licht-b) var(--licht-h) at var(--licht-x) var(--licht-y),
        rgb(255 255 255 / var(--licht-staerke)) 0%,
        rgb(255 255 255 / calc(var(--licht-staerke) * 0.45)) 45%,
        rgb(255 255 255 / 0) 75%
      ),
      var(--color-surface-default);
  }

  /* Rote Kante am unteren Rand des Hero, bevor die naechste Sektion
     beginnt.

     flex: 0 0 — als Flex-Kind gaebe der Sockel sonst nach, sobald der
     Text darueber die Mindesthoehe ausreizt. Mit `height` allein und
     dem voreingestellten flex-shrink: 1 wird er auf schmalen oder
     kurzen Viewports duenner, ohne dass man den Grund sieht. */
  .sockel {
    flex: 0 0 var(--sockel-h);
    background: var(--color-brand-strong);
  }

  .wrap {
    width: 100%;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .inhalt {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Unter 768 px steht das Motiv VOR dem Text, zugeschnitten und mit
     schraeger Unterkante — siehe Block „unter 768" am Ende. */
  .motiv {
    /* position: relative auch hier, nicht erst ab 768 px: Der Stempel
       haengt absolut an dieser Flaeche. Ohne den Bezug wuerde er auf
       schmalen Geraeten an die Sektion springen. */
    position: relative;
    margin: 0 calc(-1 * var(--layout-gutter));
  }

  .motiv img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ------------------------------------------------------------------
     STEMPEL AM MOTIV — die drei Werte oben anfassen.

     --stempel-gr      Durchmesser.
     --stempel-rechts  Abstand zur rechten Kante des Motivs.
     --stempel-unten   Abstand zur unteren Kante des Motivs.

     Der Kreis haengt an derselben Ecke wie das Bild (unten rechts),
     damit er beim Skalieren des Motivs an seiner Stelle bleibt.

     Die Schriftgroessen sind Bruchteile des Durchmessers, nicht Stufen
     aus der Skala: Der Stempel ist eine geschlossene Zeichnung, sein
     Text muss mit dem Kreis wachsen und nicht mit dem Fliesstext.
     Deshalb traegt der Kreis font-size: var(--stempel-gr) — 1em ist
     damit der Durchmesser.
     ------------------------------------------------------------------ */
  .stempel {
    /* 147 = 128 x 1,15, am 25. September 2026 um 15 % vergroessert,
       Vorgabe von Alexander. Am 28. September 2026 noch einmal um 10 %:
       147 x 1,1 = 161,7, gerundet 162. */
    --stempel-gr: 162px;
    /* Am 25. September 2026 nach unten und rechts versetzt, Wunsch von
       Alexander: Der Stempel ragt jetzt so tief in den roten Sockel wie
       die Siegel links (--space-8) und verdeckt weniger von Blatt und
       Hand. Vorher 24 px ueber der Unterkante. Negativ = ueber die
       Kante des Motivs hinaus.

       Nach rechts versetzt wird er erst ab 768 px (siehe unten):
       Darunter reicht das Motiv bis an den Bildschirmrand, und der
       Stempel wuerde angeschnitten. */
    --stempel-rechts: var(--space-2);
    --stempel-unten: calc(-1 * var(--space-8));
    /* Leichte Drehung nach rechts. Ein Stempel, der exakt gerade
       sitzt, sieht nach Platzhalter aus; die Schraege laesst ihn
       wirken, als waere er aufgebracht worden. Positiv = im
       Uhrzeigersinn. */
    --stempel-drehung: 8deg;

    position: absolute;
    right: var(--stempel-rechts);
    bottom: var(--stempel-unten);
    z-index: 1;

    margin: 0;
    width: var(--stempel-gr);
    height: var(--stempel-gr);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-text-on-accent);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-wrap: balance;

    font-size: var(--stempel-gr);
    line-height: var(--line-height-snug);
    padding: 0 0.09em;
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--stempel-drehung));
  }

  /* Ohne Bewegung sitzt der Stempel gerade — wie die Neigung der
     Ueberschrift ist die Schraege reine Dekoration. */
  @media (prefers-reduced-motion: reduce) {
    .stempel {
      --stempel-drehung: 0deg;
    }
  }

  /* Der Satz laeuft dreizeilig, klein und ruhig — die Zahl soll
     tragen, nicht er. 0.1em ist rund ein Zehntel des Durchmessers,
     bei 162 px also rund 16 px. */
  .stempel-satz {
    font-size: 0.1em;
    font-weight: var(--font-weight-semibold);
  }

  /* Die Zahl doppelt so gross wie der Satz und im fetten Schnitt.
       Sie ist die Aussage, der Rest ist ihr Rahmen. */
  .stempel-jahr {
    display: block;
    margin-top: 0.012em;
    font-size: 0.2em;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.01em;
  }

  .text {
    padding-top: var(--space-18);
    padding-bottom: var(--space-18);
  }

  h1 {
    margin: 0;
    font-family: var(--font-family-body);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ------------------------------------------------------------------
     NEIGUNG DER ERSTEN ZEILE — nur diesen Wert anfassen.

     --neigung  Wie stark die Displayzeile nach oben kippt.
                Negativ = die Zeile steigt nach rechts an.
                0deg = gerade.

     Ein Winkel ist Geometrie, keine Stufe aus dem Abstandssystem —
     deshalb steht er als lokale Variable hier und nicht in tokens.css.

     Der Drehpunkt liegt links auf der Mittellinie: der Zeilenanfang
     bleibt an der Kante des Rasters stehen, nur das Ende hebt sich.
     Bei `left top` oder `left bottom` waere die Zeile zusaetzlich
     gewandert und der Abstand zur Unterzeile haette sich mitgeaendert.

     Die Drehung ist rein optisch — der Kasten der Zeile behaelt seine
     Lage im Fluss, die Ueberschrift rutscht also nicht.
     ------------------------------------------------------------------ */
  .zeile1 {
    --neigung: -1.5deg;

    font-family: var(--font-family-display);
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-display);
    line-height: var(--line-height-tight);

    transform: rotate(var(--neigung));
    transform-origin: left center;
  }

  /* Wer Bewegung im Browser abbestellt hat, bekommt die gerade Zeile.
     Die Neigung ist Dekoration; sie traegt keine Information. */
  @media (prefers-reduced-motion: reduce) {
    .zeile1 {
      --neigung: 0deg;
    }
  }

  .zeile2 {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
  }

  /* Der Zug ist fuer Ueberschriften ab 40 px gezeichnet (6 px dick).
     Unter 21-px-Text waere er zu schwer, deshalb duenner und mit etwas
     mehr Abstand zur Grundlinie. Geometrie der Zeichnung. */
  /* Die beiden Versprechen eine Stufe kraeftiger als der Rest der
     Zeile, nicht fett (Alexander, 28. September 2026): Sie sollen
     leicht markiert sein, neben dem unterstrichenen „Einzelunterricht"
     aber nicht mit ihm konkurrieren. Echter halbfetter Kursivschnitt,
     siehe @font-face im BaseLayout. */
  .zeile2 strong {
    font-weight: var(--font-weight-semibold);
  }

  .zeile2 :global(.unterstrichen) {
    --zug-dicke: 4px;
    --zug-abstand: -0.18em;
  }

  .unterzeile {
    margin: var(--space-6) 0 0;
    color: var(--color-text-subtle);
    max-width: var(--measure-default);
  }

  /* Die Unterzeile steht insgesamt in der gedaempften Textfarbe; das
     Kernwort bekommt die volle Helligkeit zurueck. Der Kontrast
     zwischen beiden Farben traegt die Hervorhebung.

     font-weight: inherit hebt die Fettung von <strong> wieder auf.
     Zwei Signale — heller UND fetter — waeren an dieser Stelle eines
     zu viel: Die Zeile steht direkt unter der grossen Ueberschrift,
     eine zweite fette Stelle darunter macht den Kopf unruhig. Die
     Bedeutung von <strong> bleibt fuer Screenreader erhalten, sie wird
     nur anders sichtbar gemacht. */
  .unterzeile strong {
    color: var(--color-text-default);
    font-weight: inherit;
  }

  .punkte {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Marker-Haken wie in den Sektionen 3 und 5, hier weiss auf der
     dunklen Flaeche. Kleiner als dort, weil daneben Fliesstext steht und
     keine Ueberschrift: 22 x 18 bei 17/18 px Schrift, dort 32 x 26 bei
     26 px. Die Werte sind Geometrie der Zeichnung.

     --haken-oben setzt den Haken auf die Mitte der ersten Textzeile. */
  .punkte li {
    --haken-breite: 22px;
    --haken-hoehe: 18px;
    --haken-dicke: 4px;
    --haken-oben: 3px;

    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .haken {
    flex: 0 0 auto;
    width: var(--haken-breite);
    height: var(--haken-hoehe);
    margin-top: var(--haken-oben);
    overflow: visible;
  }

  .haken path {
    fill: none;
    stroke: var(--color-text-default);
    stroke-width: var(--haken-dicke);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* Handlung: links Knopf und Beratungszeile, rechts bzw.
     auf dem Handy darunter die Siegel. */
  .handlung {
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .aktionen {
    display: flex;
  }

  /* Ein Knopf, fett und kursiv (Alexander, 28. September 2026: zwei
     aufrechte Knoepfe wirkten „steril"). Echter Kursivschnitt, siehe
     @font-face im BaseLayout. Auf dem Handy ueber die volle Breite.

     Weiss auf --color-brand (#d00000) = 5,70:1.
     WCAG 2.2, Target Size: 44 px Mindesthoehe fuer Tippziele. */
  .knopf-probe {
    display: block;
    flex: 1;
    text-align: center;
    text-decoration: none;
    font-size: var(--font-size-lg);
    font-style: italic;
    font-weight: var(--font-weight-bold);
    padding: var(--space-3) var(--space-12);
    min-height: var(--tap-target-min);
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
  }

  /* Zustaende aus den Token-Farben abgeleitet: Hover die dunkle Stufe,
     Aktiv noch einmal abgedunkelt. */
  .knopf-probe:hover {
    background: var(--color-brand-strong);
  }

  .knopf-probe:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  .knopf-probe:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Siegel -----------------------------------------------------------
     Zwei Fremd-Widgets nebeneinander. Unter der Beratungszeile,
     ab 768 px zusaetzlich in den Sockel ragend. Sie
     bringen ihre eigenen Groessen mit; wir geben ihnen nur die Zeile
     und den Abstand.

     flex-wrap bleibt: Auf schmalen Geraeten sollen sie umbrechen
     duerfen, statt sich zu quetschen. */
  /* Masse fuer Karten UND Zertifikat, deshalb hier und nicht an
     .siegel-widget. Erlaeuterung der Werte siehe unten. */
  .siegel {
    --siegel-massstab: 0.8166;
    --siegel-hoehe: 213px;
    --siegel-breite: 148px;
    --siegel-karte-hoehe: 198px;

    display: flex;
    flex-wrap: wrap;
    /* Unten buendig: Beide Siegel stehen auf derselben Linie,
       obwohl sie unterschiedlich hoch sind. */
    align-items: flex-end;
    gap: var(--space-6);
  }

  /* Alle Groessen unten sind am 1. September 2026 im Browser gemessen,
     nicht entworfen. Sie gehoeren den Widgets, nicht uns. */

  /* Die Widgets bringen feste Groessen mit. Trustindex bietet keine
     Groesseneinstellung dafuer, deshalb `zoom`.

     Warum zoom und nicht transform: transform verkleinert nur die
     Optik, der Kasten belegt weiter die alte Flaeche — daneben bliebe
     ein Loch. zoom rechnet die Verkleinerung ins Layout ein.

     --siegel-massstab gilt fuer beide Widgets. Ein Wert, eine Stelle. */
  .siegel-widget {
    /* Am 1. September 2026 auf die Haelfte, danach mehrfach
       nachjustiert, zuletzt 0,65.

       Am 25. September 2026 von 0,65 um 15 % vergroessert, Vorgabe von
       Alexander: 0,65 x 1,15 = 0,7475.

       Am 28. September 2026 noch einmal um 15 %, Vorgabe von
       Alexander: 0,7475 x 1,15 = 0,8596.

       Am selben Tag wieder um 5 % verkleinert, Vorgabe von Alexander:
       0,8596 x 0,95 = 0,8166. Wert an .siegel. */
    /* Hoehe, die ein Siegel vor dem Laden belegt. Sonst springt beim
       Nachladen alles darunter nach unten (Lighthouse, 28. September
       2026: CLS 0,04 aus genau dieser Stelle). Gemessen: 183 px bei
       Massstab 0,8596, also 213 px ungezoomt — zoom rechnet auch die
       Mindesthoehe mit, der Wert gilt deshalb fuer jeden Massstab.
       Wert des Fremdsystems. --siegel-hoehe an .siegel. */
    /* Ebenso die Breite, sonst rutscht beim Laden, was daneben
       steht, zur Seite. Gemessen: 120 und 127 px bei 0,8596, das breitere
       ungezoomt 148 px. --siegel-breite an .siegel. */

    flex: 0 0 auto;
    min-height: var(--siegel-hoehe);
    min-width: var(--siegel-breite);
    zoom: var(--siegel-massstab);
  }

  /* Beide Karten gleich gross (Alexander, 29. September 2026). Von
     sich aus ist die Trustindex-Karte 139 x 193 px, die Google-Karte
     148 x 198 px (ungezoomt, gemessen) — nebeneinander sah man den
     Versatz. Die weisse Karte ist .ti-header; sie bekommt die Masse der
     groesseren. Der Inhalt verteilt sich per space-between, damit
     „verifiziert von" bei beiden unten steht. Werte des Fremdsystems. */
  .siegel-widget :global(.ti-header) {
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
    width: var(--siegel-breite);
    min-height: var(--siegel-karte-hoehe);
  }

  /* Zertifikat: im selben Massstab wie die Karten, damit es nicht
     groesser wirkt als sie (von sich aus 217 x 44 px, gezoomt 177 x 36).
     Unten auf derselben Kante wie die weissen Karten: Deren Kasten ist
     --siegel-hoehe hoch, die Karte darin nur --siegel-karte-hoehe; um
     genau die Differenz steht die Karte hoeher (live gemessen am
     29. September 2026: beide Unterkanten bei 751 px). Mindestmasse
     gegen Springen beim Nachladen. Werte des Fremdsystems. */
  .siegel-zertifikat {
    --zertifikat-breite: 217px;
    --zertifikat-hoehe: 44px;

    flex: 0 0 auto;
    min-width: var(--zertifikat-breite);
    min-height: var(--zertifikat-hoehe);
    margin-bottom: calc(var(--siegel-hoehe) - var(--siegel-karte-hoehe));
    zoom: var(--siegel-massstab);
  }

  /* ab 768 ---------------------------------------------------------- */

  @media (min-width: 768px) {
    .aktionen {
      display: block;
    }

    .knopf-probe {
      display: inline-block;
    }
  }

  /* ab 768 — zweispaltig -------------------------------------------- 

     Seit 29. September 2026 schon ab 768 px statt ab 1120 (Alexander,
     nach dem Vorbild Studienkreis): Auf dem iPad stand das Motiv unter
     dem Text, dazwischen eine grosse Luecke, und die Siegel hingen
     allein darueber. Jetzt wie am Desktop: links Text und Siegel,
     rechts das Motiv. Was nur fuers Tablet anders ist, steht im
     Block „768 bis 1119" darunter. */

  @media (min-width: 768px) {
    /* Stempel ueber die rechte Kante des Motivs hinaus, damit er
       weniger von Blatt und Hand verdeckt. Rechts ist hier Platz: Das
       Motiv endet vor dem Bildschirmrand. */
    .stempel {
      --stempel-rechts: -16px;
    }


    /* Siegel UNTER Knopf und Beratung, unten an der Spalte, und sie
       ragen wie der Stempel rechts in den roten Sockel (Alexander,
       29. September 2026). Vom 28. bis 29. September standen sie rechts
       daneben, auf einer Linie mit der Fussnote, die es nicht mehr gibt.

       margin-top: auto schiebt sie an die Unterkante der Spalte, wenn
       die Mindesthoehe des Hero sie laenger macht als ihren Inhalt.
       Der negative margin-bottom zieht sie ueber den Innenabstand der
       Spalte (--text-unten) hinaus und --space-8 tief in den Sockel —
       so tief wie der Stempel. margin statt translate: Die Siegel
       belegen dann keinen Platz im Innenabstand, und der Hero wird
       nur um das hoeher, was sie ueber dem Innenabstand brauchen.

       Gemessen am 29. September 2026: Hero 789 px bei 1440 x 850, die
       Siegel enden 13 px ueber dem Fensterrand (MacBook Air). Dafuer
       sind die Abstaende zwischen Punkten, Knopf und Siegeln kleiner
       als vorher (.handlung: margin-top und gap). */
    .handlung {
      flex: 1;
      gap: var(--space-4);
    }

    .siegel {
      margin-top: auto;
      margin-bottom: calc(-1 * (var(--text-unten) + var(--space-8)));
      gap: var(--space-4);
    }

    .hero {
      --licht-x: 72%;
      --licht-y: 42%;
      --licht-b: 62%;
      --licht-h: 80%;
    }

    .inhalt {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
    }

    /* Abstaende oben und unten wachsen mit der Fensterhoehe, damit der
       Hero samt Sockel auf niedrige Bildschirme passt (MacBook Air:
       rund 850 px nutzbare Hoehe) und auf hohen nicht gedrungen wirkt.
       Grenzen aus der Skala: oben 48 bis 112 px, unten 32 bis 72 px.
       svh = kleinste Fensterhoehe, also ohne ein- und ausfahrende
       Browserleisten. Festgelegt am 28. September 2026.

       position + z-index: Die Haarstraehnen des Motivs reichen bis in
       die zweite Zeile der Ueberschrift. Der Text liegt darueber und
       bleibt lesbar.

       display: flex, damit .handlung den Rest der Spaltenhoehe fuellen
       kann (siehe oben). */
    .text {
      position: relative;
      z-index: 1;
      flex: 0 0 55%;
      display: flex;
      flex-direction: column;
      padding-top: clamp(var(--space-12), calc(12svh - var(--space-12)), var(--space-28));
      /* Als Variable, weil die Siegel diesen Abstand ueberbruecken
         (siehe .siegel oben). */
      --text-unten: clamp(var(--space-8), 5svh, var(--space-18));
      padding-bottom: var(--text-unten);

      /* Einzug der Siegel (Alexander, 29. September 2026): Alles steht an
         der Kante, nur die Siegel ruecken ein. So endet die linke Kante
         nicht wie mit dem Lineal gezogen. Kurz zuvor war alles unter der
         Ueberschrift eingerueckt; das war zu viel. Auf dem Tablet halb so
         tief, die Spalte ist dort schmal. */
      --einzug: var(--space-12);
    }

    .siegel {
      margin-left: var(--einzug);
    }

    .handlung {
      margin-top: clamp(var(--space-4), 3svh, var(--space-12));
    }

    .punkte {
      margin-top: clamp(var(--space-4), 3svh, var(--space-8));
    }

    .motiv {
      flex: 1 1 45%;
      position: relative;
      max-width: none;
      margin: 0;
      padding: var(--space-28) 0 0;

      /* ------------------------------------------------------------
         FEINJUSTIERUNG MOTIV — nur diese drei Werte anfassen.
         Gilt ab 1120 px. Von 768 bis 1119 px richtet sich das Bild
         nach --motiv-breite (Block „768 bis 1119" unten).

         --motiv-hoehe   Hoehe des Bildes in Prozent der Spaltenhoehe.
                         Groesser = Bild groesser. Weil das Bild an der
                         rechten Kante haengt, waechst es nach links und
                         rueckt damit naeher an den Text.

         --motiv-rechts  Wie weit das Bild ueber die rechte Kante des
                         Inhalts hinausragt.

         --motiv-unten   Abstand der Bildunterkante zur Sektionskante.
                         0 = das Motiv wird von der Kante angeschnitten.
         ------------------------------------------------------------ */
      /* Am 28. September 2026 erst um 15 % vergroessert (85 x 1,15 =
         97,75), dann wieder um 5 % verkleinert: 97,75 x 0,95 = 92,86.
         Vorgaben von Alexander. */
      --motiv-hoehe: 92.86%;
      --motiv-rechts: 48px;
      --motiv-unten: 0px;
    }

    .motiv img {
      position: absolute;
      bottom: var(--motiv-unten);
      right: calc(-1 * var(--motiv-rechts));
      height: var(--motiv-hoehe);
      width: auto;
      max-width: none;
      display: block;
    }
  }

  /* 768 bis 1119 — Tablet -----------------------------------------------
     Die Textspalte ist hier schmal und dadurch hoch. Richtete sich das
     Motiv wie am Desktop nach der Spaltenhoehe, wuerde es rund 700 px
     breit und schoebe sich mit Gesicht und Blatt unter den Text
     (gemessen bei 820 px, 29. September 2026). Deshalb richtet es sich
     hier nach der Breite der rechten Spalte: --motiv-breite in Prozent
     davon. Ueber 100 %, weil das Motiv nach links in die Haare
     auslaufen darf — die liegen hinter dem Text, Gesicht und Blatt
     nicht. */
  @media (min-width: 768px) and (max-width: 1119px) {
    .text {
      --einzug: var(--space-6);
    }

    .motiv {
      --motiv-breite: 180%;
    }

    .motiv img {
      height: auto;
      width: var(--motiv-breite);
    }
  }

  /* unter 768 — Handy ------------------------------------------------------
     Aufbau nach dem Vorbild Studienkreis (Alexander, 29. September
     2026): das Motiv zuerst, direkt unter der Kopfleiste, auf Gesicht
     und Test zugeschnitten und mit schraeger Unterkante; darunter der
     Text zentriert, der Knopf ueber die volle Breite, Beratung und
     Siegel mittig.

     Bis dahin stand das Motiv NACH dem Text: Als erstes Element nahm
     es in voller Hoehe (425 px) so viel Platz, dass der Knopf auf
     einem 844 px hohen Handy bei 1009 px lag (1. September 2026). Der
     Zuschnitt haelt diesen Preis klein. */
  @media (max-width: 767px) {
    .hero {
      --licht-y: 20%;
    }

    /* --motiv-format: Seitenverhaeltnis des Ausschnitts, Breite zu
       Hoehe. --motiv-fokus: welcher Teil des Bildes im Ausschnitt
       steht (0 % oben, 100 % unten) — so, dass Gesicht und die Note
       oben auf dem Test drin sind. --motiv-schraege: wie weit die
       Unterkante rechts hoeher endet als links. Geometrie des
       Zuschnitts. */
    .motiv {
      --motiv-format: 3 / 2;
      --motiv-fokus: 34%;
      --motiv-schraege: 14%;

      order: -1;
    }

    .motiv img {
      aspect-ratio: var(--motiv-format);
      object-fit: cover;
      object-position: 50% var(--motiv-fokus);
      clip-path: polygon(
        0 0,
        100% 0,
        100% calc(100% - var(--motiv-schraege)),
        0 100%
      );
    }

    /* Stempel links unten am Bild, wie der Kreis bei Studienkreis, und
       kleiner als am Desktop: 162 px nahmen auf 390 px Breite fast die
       halbe Bildbreite ein. */
    .stempel {
      --stempel-gr: 112px;

      right: auto;
      left: var(--layout-gutter);
      bottom: var(--space-4);
    }

    /* Unten knapp: Die Siegel stehen wie bei Studienkreis kurz vor der
       roten Kante. */
    .text {
      padding-top: var(--space-6);
      padding-bottom: var(--space-8);
      text-align: center;
    }

    h1 {
      align-items: center;
    }

    .zeile1 {
      transform-origin: center;
    }

    .unterzeile {
      margin-inline: auto;
    }

    /* Die Punkte bleiben linksbuendig untereinander, der Block steht
       mittig. */
    .punkte {
      width: fit-content;
      margin-inline: auto;
      text-align: left;
    }

    .handlung {
      margin-top: var(--space-8);
    }

    .aufruf :global(.beratung) {
      justify-content: center;
    }

    .siegel {
      justify-content: center;
      gap: var(--space-4);
    }

    /* Kleiner als am Desktop (Alexander, 29. September 2026). */
    .siegel {
      --siegel-massstab: 0.65;
    }
  }
</style>
