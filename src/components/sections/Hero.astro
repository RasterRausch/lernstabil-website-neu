---
import { haken } from "../../data/zeichnungen";
import Unterstrichen from "../Unterstrichen.astro";
import Beratung from "../Beratung.astro";
// Sektion: Hero (Startseite, 1)

// Siegel von Trustindex, aus Alexanders Konto.
//
// Am 1. September 2026 stand hier zeitweise ein drittes Siegel: das
// Zertifikat „Aussergewoehnlicher Kundenservice", als Bild statt als
// Widget, weil `loader-cert.js` an die Domain gebunden ist und auf
// jeder Adresse ausser lernstabil.de nur die Meldung „Trustmark widget
// validation failed" zeigt. Alexander hat es am selben Tag wieder
// entfernt.
//
// Das Bild ist am selben Tag mitgeloescht worden. Zum Zurueckholen:
// Es stammt aus Alexanders Trustindex-Konto (Format 436 x 90). Die
// Kennung des zugehoerigen Widgets lautet 3bfd6d6807be50304926958dc7a.
// Punkte im Hero. Haken im Stil der Sektionen 3 und 5 (Marker-Haken,
// viewBox 0 0 30 24), hier weiss. Seit dem 25. September 2026 —
// vorher dünne CSS-Häkchen, die nicht zum Rest passten.
const punkte = [
  "Individueller Einzelunterricht",
  "Volle Flexibilität (Fächerwechsel)",
  // Ohne Smartphone, wie in Sektion 5 — Vorgabe von Alexander am
  // 25. September 2026.
  "Einfach per PC, Laptop oder Tablet",
];

const siegel = [
  { id: "67c6a0b8012c503e17061c29e56" },
  { id: "d7ec3be801f95047135619f0996" },
];
---

<section class="hero" aria-labelledby="hero-titel">
  <div class="wrap">
    <div class="inhalt">
      <div class="text">
        {
          /* Beide Zeilen gehoeren in die H1. Zusammengelesen ergeben
             sie die Kernaussage der Seite — genau das soll die
             Ueberschrift transportieren, auch fuer Screenreader und
             Suchmaschinen. Die Spans tragen nur die zwei
             Schriftgroessen; sie erzeugen keine eigene Gliederungsebene
             und sind semantisch unauffaellig. Die Alternative waere
             <hgroup> mit H1 und <p>; sie wurde verworfen, weil dabei
             das Versprechen aus der H1 herausfaellt. */
        }
        <h1 id="hero-titel">
          <span class="zeile1">ONLINE NACHHILFE</span>
          {
            /* <em> statt <i>: Die Vertragsfreiheit ist der Markenkern,
               die Betonung ist echt und nicht bloss typografisch.
               Screenreader heben <em> leicht hervor, <i> nicht. */
          }
          {
            /* „Einzelunterricht" mit dem roten Markerzug der
               Sektionsueberschriften (Alexander, 28. September 2026). */
          }
          <span class="zeile2"
            ><em
              ><Unterstrichen>Einzelunterricht</Unterstrichen>, <strong
                >ohne Vertragslaufzeit</strong
              > und <strong>ohne Kleingedrucktes</strong>.</em
            ></span
          >
        </h1>

        {
          /* „Nachhilfe, die ankommt" stand hier bis zum 2. September
             2026. Das Wortspiel — ankommen im Sinn von gut ankommen und
             im Sinn von wirklich beim Schueler ankommen — loest sich
             nicht ein, solange der Satz nicht sagt, WAS ankommt. Der
             Nachsatz nennt jetzt den Gegenentwurf: nicht der schnelle
             Rettungsring vor der naechsten Arbeit, sondern Stoff, der
             haelt. Das ist dieselbe Haltung wie in Sektion 3
             („Echte Foerderung statt Franchise-Fliessband"). */
        }
        <p class="unterzeile">
          <strong>Profi-Nachhilfe</strong>, die ankommt. Wir erklären, bis es
          wirklich sitzt.
        </p>

        {
          /* Drei Punkte, drei verschiedene Einwaende: Bekommt mein Kind
             genug Aufmerksamkeit? Bin ich festgelegt? Brauche ich
             Technik dafuer?

             Der erste Punkt hiess „Die ganze Stunde gehoert dem
             Schueler" — richtig gemeint, aber er klang nach
             Zeitabrechnung statt nach Zuwendung. Der zweite nannte
             „Volle Flexibilitaet (Faecherwechsel, Unterrichtszeiten)":
             eine Behauptung mit Klammer dahinter. Jetzt steht dort die
             Sache selbst, und die Unterrichtszeiten sind draussen —
             sie stehen ohnehin unter den Knoepfen. */
        }
        <ul class="punkte">
          {
            punkte.map((p) => (
              <li>
                <svg
                  class="haken"
                  viewBox="0 0 30 24"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={haken} />
                </svg>
                {p}
              </li>
            ))
          }
        </ul>

        {
          /* Ein Knopf, darunter der Anruf als Zeile — Aufbau nach dem
             Vorbild grosser Anbieter (Alexander, 28. September 2026).
             Bis dahin standen hier zwei gleich grosse Knoepfe, Telefon
             blau und Probestunde rot, darunter „Mo bis Fr, 9 bis 20 Uhr".
             Die Zeiten stehen jetzt in der Kopfleiste.

             Sternchen verweist auf die Fussnote direkt darunter.
             aria-describedby liest sie Screenreadern zum Knopf vor;
             das Sternchen selbst bleibt fuer sie stumm.

             Ab 1120 px stehen die Siegel RECHTS neben Knopf, Beratung und
             Fussnote (Alexander, 28. September 2026). Vorher standen sie
             darunter und ragten in den Sockel — der Hero war damit immer
             rund 1030 px hoch und passte auf keinen MacBook-Bildschirm. */
        }
        <div class="handlung">
          <div class="aufruf">
            <div class="aktionen">
              <a
                class="knopf-probe"
                href="/probestunde"
                aria-describedby="probestunde-hinweis"
                >Jetzt gratis testen<span aria-hidden="true">*</span></a
              >
            </div>

            <Beratung />

            {/* Fussnote zum Sternchen am Knopf. Inhalt von Alexander,
                25. September 2026. */}
            <p class="fussnote" id="probestunde-hinweis">
              <span aria-hidden="true">*</span> Die Gratis-Probestunde dauert 45
              Minuten und dient zugleich als Leistungsanalyse.
            </p>
          </div>

          {
            /* Siegel. Wie die Widgets in der Vertrauensleiste laden sie
               asynchron von cdn.trustindex.io und bringen ihr eigenes CSS
               mit; wir ruehren es nicht an und steuern nur die Flaeche.

               is:inline ist Pflicht: ohne das Attribut zieht Astro das
               Script ins eigene Bundle und der Loader verliert die
               Stelle, an der er das Siegel einsetzt. */
          }
          <div class="siegel">
            {
              siegel.map((s) => (
                <div class="siegel-widget">
                  <script
                    defer
                    async
                    is:inline
                    src={`https://cdn.trustindex.io/loader.js?${s.id}`}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="motiv">
        {
          /* Freigestellt mit Alphakanal, deshalb kein Blend-Modus.
             Erzeugte Person, auf dunklem Grund freigestellt.

             Bis zum 28. September 2026 ein PNG mit 4,9 MB. Jetzt WebP in
             vier Breiten (77 / 158 / 239 / 466 KB), erzeugt mit
             cwebp -q 82 -alpha_q 100 -resize. Die 1200er-Stufe fuer
             Handys mit hoher Pixeldichte (rund 1070 Bildpunkte), die
             sonst die grosse Datei geladen haetten. sizes: Unter 1120 px geht
             das Motiv ueber die volle Breite, darueber ist es rund 780 px
             breit (Hoehe der Spalte mal Seitenverhaeltnis). */
        }
        <img
          src="/bilder/hero-schuelerin-1494.webp"
          srcset="/bilder/hero-schuelerin-640.webp 640w, /bilder/hero-schuelerin-960.webp 960w, /bilder/hero-schuelerin-1200.webp 1200w, /bilder/hero-schuelerin-1494.webp 1494w"
          sizes="(min-width: 1120px) 780px, 100vw"
          width="1494"
          height="1628"
          alt=""
          fetchpriority="high"
        />

        {
          /* Stempel. Bewusst KEIN Pruefsiegel: kein Kranz, keine
             Sterne, keine Pruefsprache („geprueft", „zertifiziert",
             „ausgezeichnet"). Der Satz ist eine Aussage ueber uns
             selbst und eine nachpruefbare Tatsache — seit 2021 wird
             online unterrichtet, dieselbe Zahl steht in der
             Vertrauensleiste.

             Das ist der Unterschied, an dem das Wettbewerbsrecht
             haengt: Eigenwerbung ist erlaubt, der Anschein einer
             Bestaetigung durch Dritte nicht. Deshalb steht der Stempel
             auch am Motiv und nicht bei den Trustindex-Siegeln, wo er
             als drittes Fremdsiegel gelesen wuerde.

             Ein <p> statt eines Bildes: Der Satz wird vorgelesen und
             mitgesucht, er skaliert mit der Schriftgroesse und kostet
             keinen Ladevorgang. */
        }
        <p class="stempel">
          <span class="stempel-satz">Qualifizierte Nachhilfe seit</span>
          <span class="stempel-jahr">2021</span>
        </p>
      </div>
    </div>
  </div>
  {/* Roter Sockel als Abschlusskante. Rein dekorativ, ohne Inhalt. */}
  <div class="sockel"></div>
</section>

<style>
  .hero {
    /* Hoehe des roten Sockels am unteren Rand. Steht hier, weil die
       Mindesthoehe damit rechnet. */
    --sockel-h: var(--space-12);

    /* Die Kopfleiste steht im Fluss und belegt Platz. Zusammen ergeben
       Leiste und Hero 75 % der Bildschirmhöhe. Der Sockel kommt darunter
       DAZU, statt dem Inhalt Hoehe wegzunehmen — sonst schrumpft die
       Motivspalte und das Bild wird frueher angeschnitten. */
    min-height: calc(75svh - var(--layout-header-height) + var(--sockel-h));
    display: flex;
    flex-direction: column;
    overflow: hidden;

    /* Lichtkegel hinter dem Motiv, nachgebaut nach dem Studiolicht im
       Originalfoto: heller Bereich hinter Kopf und Schultern, nach
       aussen abfallend. Der Kegel wandert mit dem Motiv: unter 1120 px
       steht es unten, deshalb --licht-y: 72% — dort liegt der Kopf.
       Ab 1120 px steht es rechts.

       --licht-staerke: 0.075 ist die Obergrenze. Die Freistellung ist
       auf dunklem Grund entstanden, halbtransparente Haarpixel tragen
       Restdunkel. Deutlich heller, und um die Haare zeichnet sich ein
       Saum ab. */
    --licht-x: 50%;
    --licht-y: 72%;
    --licht-b: 90%;
    --licht-h: 55%;
    --licht-staerke: 0.075;

    background:
      radial-gradient(
        ellipse var(--licht-b) var(--licht-h) at var(--licht-x) var(--licht-y),
        rgb(255 255 255 / var(--licht-staerke)) 0%,
        rgb(255 255 255 / calc(var(--licht-staerke) * 0.45)) 45%,
        rgb(255 255 255 / 0) 75%
      ),
      var(--color-surface-default);
  }

  /* Rote Kante am unteren Rand des Hero, bevor die naechste Sektion
     beginnt.

     flex: 0 0 — als Flex-Kind gaebe der Sockel sonst nach, sobald der
     Text darueber die Mindesthoehe ausreizt. Mit `height` allein und
     dem voreingestellten flex-shrink: 1 wird er auf schmalen oder
     kurzen Viewports duenner, ohne dass man den Grund sieht. */
  .sockel {
    flex: 0 0 var(--sockel-h);
    background: var(--color-brand-strong);
  }

  .wrap {
    width: 100%;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .inhalt {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Unter 1120 px steht das Motiv NACH dem Text, nicht davor. Grund:
     Als erstes Element nahm es 425 px Hoehe und schob den Knopf auf
     1009 px — auf einem 844 px hohen Handy weit unter die Falte. So
     steht er bei rund 620 px. Gemessen am 1. September 2026. */
  .motiv {
    /* position: relative auch hier, nicht erst ab 1120 px: Der Stempel
       haengt absolut an dieser Flaeche. Ohne den Bezug wuerde er auf
       schmalen Geraeten an die Sektion springen. */
    position: relative;
    margin: 0 calc(-1 * var(--layout-gutter));
  }

  .motiv img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ------------------------------------------------------------------
     STEMPEL AM MOTIV — die drei Werte oben anfassen.

     --stempel-gr      Durchmesser.
     --stempel-rechts  Abstand zur rechten Kante des Motivs.
     --stempel-unten   Abstand zur unteren Kante des Motivs.

     Der Kreis haengt an derselben Ecke wie das Bild (unten rechts),
     damit er beim Skalieren des Motivs an seiner Stelle bleibt.

     Die Schriftgroessen sind Bruchteile des Durchmessers, nicht Stufen
     aus der Skala: Der Stempel ist eine geschlossene Zeichnung, sein
     Text muss mit dem Kreis wachsen und nicht mit dem Fliesstext.
     Deshalb traegt der Kreis font-size: var(--stempel-gr) — 1em ist
     damit der Durchmesser.
     ------------------------------------------------------------------ */
  .stempel {
    /* 147 = 128 x 1,15, am 25. September 2026 um 15 % vergroessert,
       Vorgabe von Alexander. Am 28. September 2026 noch einmal um 10 %:
       147 x 1,1 = 161,7, gerundet 162. */
    --stempel-gr: 162px;
    /* Am 25. September 2026 nach unten und rechts versetzt, Wunsch von
       Alexander: Der Stempel ragt jetzt so tief in den roten Sockel wie
       die Siegel links (--space-8) und verdeckt weniger von Blatt und
       Hand. Vorher 24 px ueber der Unterkante. Negativ = ueber die
       Kante des Motivs hinaus.

       Nach rechts versetzt wird er erst ab 1120 px (siehe unten):
       Darunter reicht das Motiv bis an den Bildschirmrand, und der
       Stempel wuerde angeschnitten. */
    --stempel-rechts: var(--space-2);
    --stempel-unten: calc(-1 * var(--space-8));
    /* Leichte Drehung nach rechts. Ein Stempel, der exakt gerade
       sitzt, sieht nach Platzhalter aus; die Schraege laesst ihn
       wirken, als waere er aufgebracht worden. Positiv = im
       Uhrzeigersinn. */
    --stempel-drehung: 8deg;

    position: absolute;
    right: var(--stempel-rechts);
    bottom: var(--stempel-unten);
    z-index: 1;

    margin: 0;
    width: var(--stempel-gr);
    height: var(--stempel-gr);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-text-on-accent);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-wrap: balance;

    font-size: var(--stempel-gr);
    line-height: var(--line-height-snug);
    padding: 0 0.09em;
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--stempel-drehung));
  }

  /* Ohne Bewegung sitzt der Stempel gerade — wie die Neigung der
     Ueberschrift ist die Schraege reine Dekoration. */
  @media (prefers-reduced-motion: reduce) {
    .stempel {
      --stempel-drehung: 0deg;
    }
  }

  /* Der Satz laeuft dreizeilig, klein und ruhig — die Zahl soll
     tragen, nicht er. 0.1em ist rund ein Zehntel des Durchmessers,
     bei 162 px also rund 16 px. */
  .stempel-satz {
    font-size: 0.1em;
    font-weight: var(--font-weight-semibold);
  }

  /* Die Zahl doppelt so gross wie der Satz und im fetten Schnitt.
       Sie ist die Aussage, der Rest ist ihr Rahmen. */
  .stempel-jahr {
    display: block;
    margin-top: 0.012em;
    font-size: 0.2em;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.01em;
  }

  .text {
    padding-top: var(--space-18);
    padding-bottom: var(--space-18);
  }

  h1 {
    margin: 0;
    font-family: var(--font-family-body);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ------------------------------------------------------------------
     NEIGUNG DER ERSTEN ZEILE — nur diesen Wert anfassen.

     --neigung  Wie stark die Displayzeile nach oben kippt.
                Negativ = die Zeile steigt nach rechts an.
                0deg = gerade.

     Ein Winkel ist Geometrie, keine Stufe aus dem Abstandssystem —
     deshalb steht er als lokale Variable hier und nicht in tokens.css.

     Der Drehpunkt liegt links auf der Mittellinie: der Zeilenanfang
     bleibt an der Kante des Rasters stehen, nur das Ende hebt sich.
     Bei `left top` oder `left bottom` waere die Zeile zusaetzlich
     gewandert und der Abstand zur Unterzeile haette sich mitgeaendert.

     Die Drehung ist rein optisch — der Kasten der Zeile behaelt seine
     Lage im Fluss, die Ueberschrift rutscht also nicht.
     ------------------------------------------------------------------ */
  .zeile1 {
    --neigung: -1.5deg;

    font-family: var(--font-family-display);
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-display);
    line-height: var(--line-height-tight);

    transform: rotate(var(--neigung));
    transform-origin: left center;
  }

  /* Wer Bewegung im Browser abbestellt hat, bekommt die gerade Zeile.
     Die Neigung ist Dekoration; sie traegt keine Information. */
  @media (prefers-reduced-motion: reduce) {
    .zeile1 {
      --neigung: 0deg;
    }
  }

  .zeile2 {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
  }

  /* Der Zug ist fuer Ueberschriften ab 40 px gezeichnet (6 px dick).
     Unter 21-px-Text waere er zu schwer, deshalb duenner und mit etwas
     mehr Abstand zur Grundlinie. Geometrie der Zeichnung. */
  /* Die beiden Versprechen eine Stufe kraeftiger als der Rest der
     Zeile, nicht fett (Alexander, 28. September 2026): Sie sollen
     leicht markiert sein, neben dem unterstrichenen „Einzelunterricht"
     aber nicht mit ihm konkurrieren. Echter halbfetter Kursivschnitt,
     siehe @font-face im BaseLayout. */
  .zeile2 strong {
    font-weight: var(--font-weight-semibold);
  }

  .zeile2 :global(.unterstrichen) {
    --zug-dicke: 4px;
    --zug-abstand: -0.18em;
  }

  .unterzeile {
    margin: var(--space-6) 0 0;
    color: var(--color-text-subtle);
    max-width: var(--measure-default);
  }

  /* Die Unterzeile steht insgesamt in der gedaempften Textfarbe; das
     Kernwort bekommt die volle Helligkeit zurueck. Der Kontrast
     zwischen beiden Farben traegt die Hervorhebung.

     font-weight: inherit hebt die Fettung von <strong> wieder auf.
     Zwei Signale — heller UND fetter — waeren an dieser Stelle eines
     zu viel: Die Zeile steht direkt unter der grossen Ueberschrift,
     eine zweite fette Stelle darunter macht den Kopf unruhig. Die
     Bedeutung von <strong> bleibt fuer Screenreader erhalten, sie wird
     nur anders sichtbar gemacht. */
  .unterzeile strong {
    color: var(--color-text-default);
    font-weight: inherit;
  }

  .punkte {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Marker-Haken wie in den Sektionen 3 und 5, hier weiss auf der
     dunklen Flaeche. Kleiner als dort, weil daneben Fliesstext steht und
     keine Ueberschrift: 22 x 18 bei 17/18 px Schrift, dort 32 x 26 bei
     26 px. Die Werte sind Geometrie der Zeichnung.

     --haken-oben setzt den Haken auf die Mitte der ersten Textzeile. */
  .punkte li {
    --haken-breite: 22px;
    --haken-hoehe: 18px;
    --haken-dicke: 4px;
    --haken-oben: 3px;

    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .haken {
    flex: 0 0 auto;
    width: var(--haken-breite);
    height: var(--haken-hoehe);
    margin-top: var(--haken-oben);
    overflow: visible;
  }

  .haken path {
    fill: none;
    stroke: var(--color-text-default);
    stroke-width: var(--haken-dicke);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* Handlung: links Knopf, Beratungszeile und Fussnote, rechts bzw.
     auf dem Handy darunter die Siegel. */
  .handlung {
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .aktionen {
    display: flex;
  }

  /* Ein Knopf, fett und kursiv (Alexander, 28. September 2026: zwei
     aufrechte Knoepfe wirkten „steril"). Echter Kursivschnitt, siehe
     @font-face im BaseLayout. Auf dem Handy ueber die volle Breite.

     Weiss auf --color-brand (#d00000) = 5,70:1.
     WCAG 2.2, Target Size: 44 px Mindesthoehe fuer Tippziele. */
  .knopf-probe {
    display: block;
    flex: 1;
    text-align: center;
    text-decoration: none;
    font-size: var(--font-size-lg);
    font-style: italic;
    font-weight: var(--font-weight-bold);
    padding: var(--space-3) var(--space-12);
    min-height: var(--tap-target-min);
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: var(--color-text-on-brand);
  }

  /* Zustaende aus den Token-Farben abgeleitet: Hover die dunkle Stufe,
     Aktiv noch einmal abgedunkelt. */
  .knopf-probe:hover {
    background: var(--color-brand-strong);
  }

  .knopf-probe:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  .knopf-probe:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Siegel -----------------------------------------------------------
     Zwei Fremd-Widgets nebeneinander. Auf dem Handy unter der
     Fussnote, ab 1120 px rechts neben Knopf und Beratungszeile. Sie
     bringen ihre eigenen Groessen mit; wir geben ihnen nur die Zeile
     und den Abstand.

     flex-wrap bleibt: Auf schmalen Geraeten sollen sie umbrechen
     duerfen, statt sich zu quetschen. */
  .siegel {
    display: flex;
    flex-wrap: wrap;
    /* Unten buendig: Beide Siegel stehen auf derselben Linie,
       obwohl sie unterschiedlich hoch sind. */
    align-items: flex-end;
    gap: var(--space-6);
  }

  /* Alle Groessen unten sind am 1. September 2026 im Browser gemessen,
     nicht entworfen. Sie gehoeren den Widgets, nicht uns. */

  /* Fussnote: klein, gedaempft, nicht kursiv, direkt unter der
     Beratungszeile. --color-text-subtle auf der Heroflaeche rund 8:1.
     Die Breite haelt sie auf zwei kurze Zeilen. */
  .fussnote {
    max-width: var(--measure-narrow);
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--color-text-subtle);
  }

  /* Die Widgets bringen feste Groessen mit. Trustindex bietet keine
     Groesseneinstellung dafuer, deshalb `zoom`.

     Warum zoom und nicht transform: transform verkleinert nur die
     Optik, der Kasten belegt weiter die alte Flaeche — daneben bliebe
     ein Loch. zoom rechnet die Verkleinerung ins Layout ein.

