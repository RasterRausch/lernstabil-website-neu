---
import Unterstrichen from "../Unterstrichen.astro";
// Sektion: Preise (Startseite, 7)
//
// Ersetzt die drei Paketkarten der bestehenden Seite (Flex, Fokus,
// Intensiv). Festgelegt mit Alexander am 14. September 2026:
//
// - KEIN PAKET ZUM AUSWAEHLEN. Drei Karten nebeneinander verlangen eine
//   Entscheidung — genau die Bindung, die #Lernstabil nicht hat.
//   Stattdessen ein Preis, der mit der Zahl der Stunden von selbst
//   sinkt. Die Stufen werden nicht gebucht, sondern am Monatsende
//   angewendet.
// - „MONATLICH KUENDBAR" ENTFAELLT. Kuendigen setzt einen Vertrag
//   voraus; die Seite verspricht, dass es keinen gibt.
// - DER PREIS STEHT NIE ALLEIN. Direkt daneben, was nicht dazukommt.
//   Dieselbe Zahl wirkt dann ehrlich statt teuer.
// - DER VERGLEICH nennt keine Anbieter. Er gibt Eltern die zwei
//   Fragen an die Hand, an denen die beworbenen Kettenpreise scheitern
//   (Gruppenpreis, 24 Monate Laufzeit — belegt in der
//   Wettbewerbsrecherche, Commit 4fd1997).
//
// Gestaltung neu am 25. September 2026. Alexanders Kritik an der
// ersten Fassung: weiss, ohne Kontrast, „wie mit dem Textprogramm
// gemacht". Die Sektion uebernimmt jetzt die Mittel des Hero —
// dunkle Flaeche, Displayschrift, rote Kante, Stempel, das weisse
// Blatt — statt eine eigene, leisere Sprache zu sprechen:
//
// - Der Grundpreis steht in der Displayschrift und ist die lauteste
//   Zahl der Seite.
// - Neben ihm wird durchgestrichen, was andere berechnen. Das zeigt
//   den Vorteil, statt ihn als Haekchenliste aufzuzaehlen.
// - Die Nachlassstufen sind eine Treppe aus massiven Bloecken.
// - Der Vergleich liegt als Zettel auf der Flaeche, wie das Blatt,
//   das die Schuelerin im Hero haelt.
//
// Preise, Absage- und Ferienregel von Alexander bestaetigt am
// 14. September 2026. Stufen neu am 25. September 2026, Vorgabe von
// Alexander: bis 8 Unterrichtsstunden 28,95 € (1x pro Woche 90
// Minuten), 9 bis 16 25,95 € (bis 8 Termine zu je 90 Minuten), ab 17
// 22,50 € (mehr als 8 Termine), nach oben offen. Die Stunden einer Familie zaehlen zusammen — auch
// das seine Vorgabe („das muss ja nicht immer ein Schueler sein").
//
// Die Beispiele an den Stufen und die Ersparnis in den Stempeln sind
// reine Umrechnung (1 Termin = 90 Minuten = 2 Unterrichtsstunden;
// 28,95 − 25,95 = 3,00; 28,95 − 22,50 = 6,45). Die Stufen sind ueber
// Termine pro Woche erklaert, weil „16 Unterrichtsstunden" nach viel
// klingt — Alexanders Einwand.

const telefon = "0341 658 329 18";
const telefonHref = "tel:+4934165832918";

// Was bei uns nicht dazukommt. Jeder Posten wird durchgestrichen;
// `zusatz` steht darunter und bleibt lesbar, weil er die Bedingung
// nennt.
//
// `klartext` erscheint als Infobox beim Ueberfahren, Antippen oder
// Fokussieren — durchgestrichen ist der Posten schwer zu lesen
// (Alexander, 25. September 2026). Dieselben Aussagen wie in der
// bestaetigten Liste vom 14. September 2026, nur ausgeschrieben.
const posten = [
  { name: "Anmeldegebühr", klartext: "Keine Anmeldegebühr" },
  { name: "Materialkosten", klartext: "Keine Materialkosten" },
  { name: "Vertragslaufzeit", klartext: "Keine Vertragslaufzeit" },
  { name: "Kündigungsfrist", klartext: "Keine Kündigungsfrist" },
  {
    name: "Ausfallgebühr",
    zusatz: "bei Absage bis 24 Stunden vorher",
    klartext: "Keine Ausfallgebühr, wenn Sie bis 24 Stunden vorher absagen",
  },
  {
    name: "Zahlung in den Ferien",
    klartext: "In den Ferien zahlen Sie nichts",
  },
];

// ersparnis: nur an den Stufen mit Nachlass. Sie tragen Gold und einen
// Stempel — siehe Kommentar an .stufen.
const stufen = [
  {
    menge: "bis 8 Unterrichtsstunden im Monat",
    preis: "28,95 €",
    hinweis: "z. B. 1× pro Woche 90 Minuten",
  },
  {
    menge: "ab 9 Unterrichtsstunden im Monat",
    preis: "25,95 €",
    hinweis: "z. B. 8 Termine zu je 90 Minuten",
    ersparnis: "3,00 €",
  },
  {
    menge: "ab 17 Unterrichtsstunden im Monat",
    preis: "22,50 €",
    hinweis: "mehr als 8 Termine zu je 90 Minuten",
    ersparnis: "6,45 €",
  },
];

// Gezeichneter Markerstrich, einmal fuer das Durchstreichen, einmal
// fuer die Unterstreichung am Zettel. Die Welle ist leicht
// unregelmaessig, damit der Strich nicht nach Textauszeichnung
// aussieht. viewBox 100 x 10, gestreckt ueber preserveAspectRatio.
const strich = "M1 6 C 18 3, 34 7, 52 5 S 82 3, 99 5";
---

<section class="preise" id="preise" aria-labelledby="preise-titel">
  {/* Rote Kante oben. Rein dekorativ, deshalb ohne Inhalt. */}
  <div class="keil"></div>

  <div class="wrap">
    <div class="kopf">
      <p class="vorzeile">Preise</p>
      <h2 id="preise-titel">
        Sie zahlen nur,{" "}
        <Unterstrichen>was stattfindet</Unterstrichen>
      </h2>
      <p class="einleitung">
        Kein Vertrag, kein Abo, keine Kündigungsfrist. Sie entscheiden nach
        jeder Stunde neu, ob es weitergeht.
      </p>
    </div>

    {/* Grundpreis und was nicht dazukommt ---------------------------- */}
    <div class="grundpreis">
      <div class="betrag-block">
        <p class="betrag">28,95&nbsp;€</p>
        <p class="einheit">je Unterrichtsstunde (45&nbsp;Minuten)</p>
        {
          /* Der Preis gilt fuer 45 Minuten, ein Termin dauert aber meist
             90. Ohne diesen Satz rechnet jemand die Stufen („16
             Unterrichtsstunden") in Termine um und erschrickt. */
        }
        <p class="termin">
          Ein Termin dauert in der Regel 90&nbsp;Minuten – also zwei
          Unterrichtsstunden.
        </p>
        <p class="inklusive">
          Einzelunterricht mit festem Dozenten.
          <br />Alle Fächer, alle Klassenstufen.
        </p>
      </div>

      <div class="ohne">
        <h3>Was bei uns nicht dazukommt</h3>
        <ul class="posten">
          {
            posten.map((p, i) => (
              <li tabindex="0" aria-describedby={`posten-klartext-${i}`}>
                <span class="posten-name">
                  {p.name}
                  <svg
                    class="strich"
                    viewBox="0 0 100 10"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={strich} />
                  </svg>
                </span>
                {p.zusatz && <span class="posten-zusatz">{p.zusatz}</span>}
                <span
                  class="klartext"
                  role="tooltip"
                  id={`posten-klartext-${i}`}
                >
                  {p.klartext}
                </span>
              </li>
            ))
          }
        </ul>

        {
          /* Hand, die die Posten streicht. Erzeugtes Bild (Firefly),
             von Alexander freigestellt, 520 x 550. Rein dekorativ:
             Sie zeigt nur, was die Striche ohnehin sagen. Das Skript
             unten bewegt sie; ohne Skript bleibt sie unsichtbar. */
        }
        <img
          class="hand"
          src="/bilder/hand-marker.webp"
          width="520"
          height="550"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    {/* Treppe ------------------------------------------------------- */}
    <div class="nachlass">
      <h3>Wer mehr lernt, zahlt automatisch weniger</h3>

      <ol class="stufen">
        {
          stufen.map((s, i) => (
            <li class:list={{ rabatt: s.ersparnis }} style={`--stufe: ${i}`}>
              <span class="menge">{s.menge}</span>
              <span class="stufe-preis">{s.preis}</span>
              <span class="hinweis">{s.hinweis}</span>
              {s.ersparnis && (
                <span class="stempel">
                  <span class="stempel-betrag">{s.ersparnis}</span>
                  <span class="stempel-satz">weniger je Stunde</span>
                </span>
              )}
            </li>
          ))
        }
      </ol>

      {
        /* Geschwister: Die Stunden einer Familie zaehlen zusammen.
           Das Rechenbeispiel ist reine Umrechnung der Stufen.

           Die Doodly-Hand zieht einen roten Kreis darum, wenn der
           Hinweis ins Bild kommt — Wunsch von Alexander statt der
           roten Linie. Die Form berechnet scripts/doodle-hand.ts aus der
           Groesse des Blocks (kreisZiehen). */
      }
      <div class="familie-rahmen">
        <p class="familie" data-kreis-inhalt>
          <strong>Für Geschwister:</strong> Die Stunden aller Kinder einer
          Familie zählen zusammen. Zwei Kinder mit je einem 90-Minuten-Termin
          pro Woche kommen auf 16 Unterrichtsstunden und zahlen 25,95&nbsp;€
          statt 28,95&nbsp;€ – bei drei Kindern sind es nur noch
          22,50&nbsp;€.
        </p>
        <svg class="kreis" aria-hidden="true" focusable="false">
          <path></path>
        </svg>
        <img
          class="hand"
          src="/bilder/hand-marker.webp"
          width="520"
          height="550"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </div>

      <p class="abrechnung">
        Nichts buchen, nichts ankündigen: Am Monatsende rechnen wir ab, was
        tatsächlich stattgefunden hat. Erreicht der Monat eine Stufe, gilt der
        günstigere Satz für alle Stunden dieses Monats.
      </p>
    </div>

    {/* Aktion — dieselben zwei Knoepfe wie im Hero ------------------- */}
    <div class="aktion">
      <div class="knoepfe">
        <a
          class="knopf-probe"
          href="#probestunde"
          aria-describedby="probestunde-hinweis-preise"
          >Gratis Probestunde sichern<span aria-hidden="true">*</span></a
        >
        <a class="knopf-telefon" href={telefonHref}>
          {/* Die Nummer steht im Linktext, das Icon ist dekorativ. */}
          <svg
            class="icon-telefon"
            viewBox="0 0 24 24"
            fill="currentColor"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4 3h4l2 5-2.5 1.5a12.5 12.5 0 0 0 7 7L16 14l5 2v4h-1C11 20 4 13 4 4V3z"
            ></path>
          </svg>
          <span>{telefon}</span>
        </a>
      </div>
      <p class="zeiten">Mo bis Fr, 9 bis 20 Uhr</p>
      {/* Fussnote zum Sternchen, Wortlaut wie im Hero. */}
      <p class="fussnote" id="probestunde-hinweis-preise">
        <span aria-hidden="true">*</span> Die Gratis-Probestunde dauert 45
        Minuten und dient zugleich als Leistungsanalyse.
      </p>
    </div>

    {/* Vergleich als Zettel ----------------------------------------- */}
    <div class="zettel">
      <h3>Bevor Sie woanders unterschreiben:</h3>
      <ol class="fragen">
        <li>
          <p class="frage">Einzelunterricht oder Gruppe?</p>
          <p>
            Die niedrigen Preise, mit denen große Anbieter werben, sind fast
            immer Gruppenpreise. Der Einzelunterricht kostet dort ein
            Vielfaches.
          </p>
        </li>
        <li>
          <p class="frage">Gilt der Preis nur mit Laufzeit?</p>
          <p>
            Die günstigsten Angebote setzen oft eine Bindung von 24 Monaten
            voraus. Rechnen Sie die Gesamtsumme aus, bevor Sie unterschreiben.
          </p>
        </li>
      </ol>
      <p class="fazit">
        <span class="unterstrichen">
          Unser Preis gilt ab der ersten Stunde und ohne Bindung.
          <svg
            class="strich"
            viewBox="0 0 100 10"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <path d={strich} />
          </svg>
        </span>
      </p>
    </div>
  </div>
</section>

<script>
  // Die Hand streicht die Posten — Doodly-Art, einmal beim ersten
  // Hineinscrollen. Sie kommt von rechts unten, zieht einen Strich nach
  // dem anderen, danach wird das Wort grau. Die Hand selbst und die
  // Regeln fuer reduzierte Bewegung stehen in scripts/doodle-hand.ts.
  import {
    AUFDECKEN,
    Hand,
    KURVE_ZUG,
    beimErstenBlick,
    kreisZiehen,
  } from "../../scripts/doodle-hand";

  // Dauer eines Strichs in Millisekunden. Am 25. September 2026 von
  // 350 auf 500 angehoben („da liegt gar kein Gewicht drin").
  const STRICH = 500;

  const bereich = document.querySelector<HTMLElement>(".preise .ohne");
  const liste = bereich?.querySelector<HTMLElement>(".posten");
  const bild = bereich?.querySelector<HTMLImageElement>(".hand");

  if (bereich && liste && bild) {
    beimErstenBlick(
      liste,
      bild,
      () => liste.classList.add("animiert"),
      async () => {
        const hand = new Hand(bild, bereich);
        for (const li of liste.querySelectorAll<HTMLElement>("li")) {
          const strich = li.querySelector<SVGElement>(".strich")!;
          const r = hand.rahmen(strich);
          const y = r.y + r.h / 2;

          await hand.hin({ x: r.x, y });
          strich.animate(AUFDECKEN, {
            duration: STRICH,
            easing: KURVE_ZUG,
            fill: "forwards",
          });
          await hand.zieh([{ x: r.x + r.b, y }], STRICH);
          li.classList.add("erledigt");
        }
        await hand.weg();
      },
      () => liste.classList.remove("animiert"),
    );
  }

  // Roter Kreis um den Geschwister-Hinweis.
  const familie = document.querySelector<HTMLElement>(
    ".preise .familie-rahmen",
  );
  if (familie) kreisZiehen(familie);
</script>

<style>
  .preise {
    position: relative;
    background: var(--color-surface-default);
    color: var(--color-text-default);
    padding: 0 0 var(--space-28);
    /* Die Hand der Strich-Animation kommt von rechts ausserhalb herein.
       Ohne das entstuende waehrenddessen eine waagerechte Scrollleiste.
       clip statt hidden: Es entsteht kein Scrollcontainer, die sticky
       Kopfleiste und scroll-margin bleiben unberuehrt. */
    overflow-x: clip;
    /* Die Kopfleiste ist sticky. Ohne diesen Abstand verschwaende die
       Vorzeile beim Sprung ueber „Preise" in der Navigation darunter. */
    scroll-margin-top: var(--layout-header-height);
  }

  /* Rote Kante ------------------------------------------------------------
     Trennt die Sektion von der Kreidetafel davor — beide sind dunkel.
     Dieselbe Farbe wie der Sockel im Hero, aber schraeg: links volle
     Hoehe, rechts laeuft sie auf ein Viertel aus. Die Schraege ist der
     Keil aus tokens.css (--color-brand, „Sockel, Keil").

     --keil-rest: Hoehe der Kante am rechten Rand, als Anteil. Geometrie
     der Form, keine Abstandsstufe. */
  .keil {
    --keil-rest: 25%;

    height: var(--space-12);
    background: var(--color-brand-strong);
    clip-path: polygon(0 0, 100% 0, 100% var(--keil-rest), 0 100%);
  }

  .wrap {
    width: 100%;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  /* Kopf ------------------------------------------------------------------
     Aufbau wie Sektion 3 und 5. Die Vorzeile in Weiss und Versalien wie
     in Sektion 6: Das Blau der hellen Sektionen erreicht auf dieser
     Flaeche nicht genug Kontrast. */

  .kopf {
    padding-top: var(--space-18);
    text-align: center;
  }

  .vorzeile {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-relaxed);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    margin: var(--space-2) auto 0;
    max-width: 28ch;
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  .einleitung {
    margin: var(--space-6) auto 0;
    max-width: var(--measure-wide);
    color: var(--color-text-subtle);
  }

  h3 {
    margin: 0;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-snug);
  }

  /* Grundpreis ------------------------------------------------------------
     Links die Zahl, rechts die gestrichenen Posten. Unter 1120 px
     untereinander. */

  .grundpreis {
    margin-top: var(--space-18);
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 1120px) {
    .grundpreis {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-18);
    }
  }

  /* Die Zahl in der Displayschrift und in 6xl, der einzigen Stufe
     ueber der Hero-Ueberschrift. Weiss, nicht rot und nicht gold: Rot
     liest sich als Sonderangebot, und das Gold gehoert den Stufen. Die
     Neigung ist dieselbe wie bei „ONLINE NACHHILFE" im Hero. */
  .betrag {
    --neigung: -1.5deg;

    margin: 0;
    font-family: var(--font-family-display);
    font-size: var(--font-size-6xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    white-space: nowrap;
    transform: rotate(var(--neigung));
    transform-origin: left center;
  }

  .einheit {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    color: var(--color-text-subtle);
  }

  .termin {
    margin: var(--space-1) 0 0;
    color: var(--color-text-subtle);
  }

  .inklusive {
    margin: var(--space-6) 0 0;
    padding-left: var(--space-4);
    border-left: var(--space-1) solid var(--color-brand);
    font-weight: var(--font-weight-semibold);
  }

  /* Gestrichene Posten ----------------------------------------------------
     Die Posten stehen in der Displayschrift, der Strich ist ein
     gezeichneter Markerzug in Rot — wie mit dem Stift auf einer
     Rechnung gestrichen. Er steht ueber dem Wort, nicht dahinter, und
     laesst es trotzdem lesbar: 4 px Strich auf rund 26 px Schrift.

     Kein <s> und kein <del>: Die Posten sind nicht geloescht, sie
     fallen weg. Das sagt die Ueberschrift, und die liest ein
     Screenreader mit.

     --strich-dicke, --strich-ueberstand, --strich-hoehe: Geometrie der
     Zeichnung. Der Ueberstand laesst den Strich links und rechts ueber
     das Wort hinausragen, so wie man von Hand streicht. */

  .ohne h3 {
    font-size: var(--font-size-md);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .posten {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4) var(--space-8);
  }

  @media (min-width: 768px) {
    .posten {
      grid-template-columns: repeat(2, auto);
      justify-content: start;
    }
  }

  .posten li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    cursor: default;
  }

  /* Fokus fuer Tastatur und Antippen: derselbe Ring wie im Rest der
     Seite, mit etwas Luft um das Wort. */
  .posten li:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--space-1);
  }

  /* Infobox mit dem Klartext ---------------------------------------------
     Ueber dem Posten, weiss auf der dunklen Flaeche wie der Zettel
     weiter unten. Erscheint beim Ueberfahren, beim Fokussieren mit der
     Tastatur und beim Antippen auf dem Handy (das fokussiert den Posten,
     dafuer das tabindex im Markup). Ohne Skript.

     --spitze: Groesse des kleinen Dreiecks unter der Box, Geometrie der
     Zeichnung. Bleibt die Maus auf der Box, bleibt sie offen (WCAG
     1.4.13, „hoverable") — sie liegt im Posten, also zaehlt sie zu
     dessen :hover. Eine unsichtbare Bruecke (::before) ueberspannt die
     Luecke zwischen Wort und Box, damit sie beim Hinueberfahren nicht
     zuklappt. */
  .klartext {
    --spitze: 7px;

    position: absolute;
    left: 0;
    bottom: calc(100% + var(--spitze) + var(--space-1));
    z-index: 3;
    width: max-content;
    max-width: 22em;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-normal);
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--space-1));
    transition:
      opacity 0.15s ease-out,
      transform 0.15s ease-out,
      visibility 0.15s;
    pointer-events: none;
  }

  .klartext::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: calc(var(--spitze) + var(--space-1));
  }

  .klartext::after {
    content: "";
    position: absolute;
    left: var(--space-4);
    top: 100%;
    border: var(--spitze) solid transparent;
    border-top-color: var(--color-surface-inverse);
  }

  .posten li:hover .klartext,
  .posten li:focus .klartext {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .klartext {
      transition: none;
    }
  }

  .posten-name {
    --strich-ueberstand: 6px;

    position: relative;
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-normal);
    /* Endzustand: gestrichen und zurueckgetreten. Die Animation setzt
       das Wort vorher auf volle Helligkeit. */
    color: var(--color-text-subtle);
  }

  .posten-zusatz {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .strich {
    --strich-dicke: 4px;
    --strich-hoehe: 0.4em;

    position: absolute;
    left: calc(-1 * var(--strich-ueberstand, 0px));
    width: calc(100% + 2 * var(--strich-ueberstand, 0px));
    top: 50%;
    height: var(--strich-hoehe);
    transform: translateY(-50%);
    overflow: visible;
    pointer-events: none;
  }

  /* Animation: Eine Hand zieht die Striche, Posten fuer Posten.
     Ablauf und Zeiten stehen im Skript oben — Hand und Strich muessen
     dieselbe Dauer und Kurve haben, deshalb steuert beides das Skript.

     Ohne Skript und bei abbestellter Bewegung stehen die Striche
     einfach da. Das Skript setzt .animiert nur, wenn es laufen darf;
     erst dann sind die Striche verdeckt, bis die Hand sie zieht.

     clip-path statt stroke-dashoffset: Der Strich hat
     vector-effect: non-scaling-stroke, und Strichmuster rechnen dann
     in Bildschirmpixeln statt in Pfadlaenge. Das Abdecken von rechts
     ist davon unabhaengig.

     Nach dem Strich tritt das Wort in --color-text-subtle zurueck
     (8,4:1 auf der Flaeche, bleibt also lesbar). Der Strich hat damit
     eine Folge: Der Posten ist sichtbar erledigt. Ohne Animation gilt
     derselbe Endzustand, siehe .posten-name. */

  /* 7 statt 4 px: kraeftiger als die Unterstreichung am Zettel. Das
     Wort bleibt trotzdem lesbar, weil es danach grau zuruecktritt und
     der rote Strich davor steht. */
  .posten .strich {
    --strich-dicke: 7px;
  }

  .posten.animiert .strich {
    clip-path: inset(0 100% 0 0);
  }

  .posten.animiert .posten-name {
    color: var(--color-text-default);
  }

  .posten.animiert li.erledigt .posten-name {
    --wort-dauer: 0.4s;

    color: var(--color-text-subtle);
    transition: color var(--wort-dauer) ease-out;
  }

  /* Die Hand ------------------------------------------------------------
     Liegt ueber dem Bereich, links oben verankert; das Skript verschiebt
     sie per transform, sodass die Stiftspitze auf dem Strich sitzt.

     --hand-breite: Groesse des Bildes, gewaehlt nach der Schrift der
     Posten — die Stiftspitze soll etwa so breit wirken wie der Strich.
     Ausserhalb der Animation unsichtbar; visibility statt display,
     damit das Skript die Groesse messen kann. */
  .ohne {
    position: relative;
  }

  .hand {
    --hand-breite: 200px;

    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: var(--hand-breite);
    height: auto;
    max-width: none;
    pointer-events: none;
    visibility: hidden;

    /* Das Bild endet rechts unten mit einer rechtwinkligen Schnittkante
       durch den Aermel. Im Video laege sie ausserhalb des Bildes, hier
       steht die Hand mitten auf der Seite. Die Maske schneidet den
       Aermel stattdessen schraeg ab, quer zum Arm — Idee von Alexander
       am 25. September 2026.

       --schnitt-winkel  Richtung des Arms (150deg = nach rechts unten,
                         steiler als die Diagonale). Die Schnittlinie
                         steht senkrecht dazu.
       --schnitt         Lage der Schnittlinie entlang des Arms. Bei
                         150deg beruehrt der Aermel den Bildrand ab
                         87 %; weiter hinten darf der Schnitt nicht
                         liegen, sonst kommt die alte Ecke zurueck. Das
                         Buendchen beginnt bei rund 70 %.
       --schnitt-weich   Breite des Uebergangs. 0 % = harte Kante. */
    --schnitt-winkel: 150deg;
    --schnitt: 85%;
    --schnitt-weich: 0%;
    mask-image: linear-gradient(
      var(--schnitt-winkel),
      #000 calc(var(--schnitt) - var(--schnitt-weich)),
      transparent var(--schnitt)
    );
  }

  @media (min-width: 768px) {
    .hand {
      --hand-breite: 260px;
    }
  }

  .strich path {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: var(--strich-dicke);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* Treppe ----------------------------------------------------------------
     Drei massive Bloecke statt einer Linie mit Punkten. Jede Stufe ist
     hoeher als die vorige: Mehr Stunden heben einen eine Stufe hinauf,
     der Preis darin sinkt.

     GOLD fuer die Stufen mit Nachlass. Die Rolle ist in tokens.css als
     „markiert Erreichtes, fordert zu nichts auf" angelegt — genau das
     ist eine Stufe, die man durch Lernen erreicht. Weiss auf Gold
     4,7:1. Die erste Stufe liegt auf --color-surface-raised mit einer
     Linie in --color-border-default, damit sie sich von der Flaeche
     abhebt, ohne mit den goldenen zu konkurrieren.

     --stufe kommt als Index aus dem Markup (0, 1, 2). Die Hoehe waechst
     ueber den Innenabstand unten; der Text sitzt deshalb immer oben im
     Block, und die Unterkanten stehen auf einer Linie.

     Unter 1120 px: untereinander, jede Stufe breiter als die vorige.
     Dieselbe Idee, um 90 Grad gedreht. */

  .nachlass {
    margin-top: var(--space-28);
  }

  .nachlass h3 {
    text-align: center;
    font-size: var(--font-size-3xl);
  }

  .stufen {
    --stufe-hub: var(--space-12);

    margin: var(--space-18) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .stufen li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-right: calc(var(--stufe-hub) * (2 - var(--stufe)));
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border-top: var(--space-1) solid var(--color-border-default);
  }

  .stufen li.rabatt {
    /* Platz rechts oben fuer den Stempel, der ueber die Ecke ragt. */
    padding-right: calc(var(--stempel-gr) / 2 + var(--space-6));
    background: var(--color-accent);
    border-top-color: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  .menge {
    font-weight: var(--font-weight-semibold);
  }

  .stufe-preis {
    font-family: var(--font-family-display);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-normal);
  }

  .hinweis {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .rabatt .hinweis {
    color: var(--color-text-on-accent);
  }

  @media (min-width: 1120px) {
    .stufen {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      align-items: end;
      gap: var(--space-4);
    }

    .stufen li {
      margin-right: 0;
      padding: var(--space-8);
      padding-bottom: calc(var(--space-8) + var(--stufe-hub) * var(--stufe));
    }

    /* Ab 1120 sitzt der Stempel zur Haelfte ueber der Oberkante und
       ist breit genug vom Text entfernt — kein Freiraum rechts noetig,
       sonst bricht die Mengenangabe unnoetig um. */
    .stufen li.rabatt {
      padding-right: var(--space-8);
    }

    /* .stufen davor, weil die Grundregel des Stempels weiter unten
       steht und sonst gewinnt. */
    .stufen .stempel {
      top: calc(-1 * var(--stempel-gr) / 2);
    }
  }

  /* Stempel an den Stufen --------------------------------------------------
     Wie der Stempel im Hero: Kreis, leicht gedreht, Schriftgroessen als
     Bruchteile des Durchmessers (1em = Durchmesser). Rot statt Gold,
     weil er auf einem goldenen Block sitzt; Weiss auf --color-brand
     5,7:1.

     Er ragt ueber die rechte obere Ecke hinaus — halb auf dem Block,
     halb auf der Flaeche. So sieht er aufgebracht aus und nicht
     eingesetzt. */
  .stufen {
    --stempel-gr: 104px;
  }

  .stempel {
    --stempel-drehung: 8deg;

    position: absolute;
    top: calc(-1 * var(--stempel-gr) / 3);
    right: calc(-1 * var(--stempel-gr) / 4);
    z-index: 1;

    width: var(--stempel-gr);
    height: var(--stempel-gr);
    border-radius: var(--radius-full);
    background: var(--color-brand);
    color: var(--color-text-on-brand);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-wrap: balance;
    padding: 0 0.16em;

    font-size: var(--stempel-gr);
    line-height: var(--line-height-snug);
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--stempel-drehung));
  }

  .stempel-betrag {
    font-size: 0.22em;
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
  }

  .stempel-satz {
    margin-top: 0.03em;
    font-size: 0.12em;
    font-weight: var(--font-weight-semibold);
  }

  /* Auf schmalen Geraeten ragt der Stempel nicht rechts hinaus — dort
     laege er im Gutter und stiesse an den Bildschirmrand. Er sitzt
     stattdessen zur Haelfte ueber der Oberkante, und der Text beginnt
     erst unter ihm: 48 px Innenabstand oben gegen 44 px, die der
     Stempel in den Block hineinreicht. */
  @media (max-width: 767px) {
    .stufen {
      --stempel-gr: 88px;
    }

    .stufen li.rabatt {
      padding-top: var(--space-12);
      padding-right: var(--space-6);
    }

    .stempel {
      top: calc(-1 * var(--stempel-gr) / 2);
      right: var(--space-2);
    }
  }

  /* Geschwister-Hinweis: eine Zusage, die man nicht ueberlesen soll.
     Die Doodly-Hand zieht einen roten Kreis darum (vorher eine rote
     Linie links, Alexander fand sie langweilig). Der Rahmen gibt Hand
     und Kreis ihren Bezug; der Innenabstand haelt den Text vom Kreis
     frei. */
  .familie-rahmen {
    position: relative;
    margin: var(--space-12) auto 0;
    max-width: calc(var(--measure-wide) + 2 * var(--space-8));
  }

  .familie {
    margin: 0;
    padding: var(--space-6) var(--space-8);
    text-align: center;
    color: var(--color-text-subtle);
  }

  /* Die Zeichnung liegt ueber dem ganzen Rahmen. Pfad und viewBox setzt
     das Skript in Pixeln der tatsaechlichen Groesse, damit der Strich
     beim Ziehen gleichmaessig bleibt — gestreckt wuerde er dick und
     duenn. --kreis-dicke wie der Strich bei den Posten. */
  .kreis {
    --kreis-dicke: 5px;

    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .kreis path {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: var(--kreis-dicke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .familie strong {
    color: var(--color-text-default);
    font-weight: var(--font-weight-bold);
  }

  .abrechnung {
    margin: var(--space-12) auto 0;
    max-width: var(--measure-wide);
    text-align: center;
    color: var(--color-text-subtle);
  }

  /* Aktion — Knoepfe wie im Hero -------------------------------------------
     Rot fuer die Probestunde, Blau fuer das Telefon. Dieselben Farben,
     dieselbe Form wie oben auf der Seite: Wer bis hierher gelesen hat,
     erkennt die Handlung wieder. */

  .aktion {
    margin-top: var(--space-12);
    text-align: center;
  }

  .knoepfe {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .knoepfe {
      flex-direction: row;
      justify-content: center;
    }
  }

  .knopf-probe,
  .knopf-telefon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap-target-min);
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  /* Ohne Abstand: Er ist fuer das Telefon-Symbol im Nachbarknopf da.
     Hier stuende er zwischen Text und Sternchen. */
  .knopf-probe {
    gap: 0;
    background: var(--color-brand);
    color: var(--color-text-on-brand);
  }

  .knopf-probe:hover {
    background: var(--color-brand-strong);
  }

  .knopf-probe:active {
    background: var(--color-brand-stronger);
    transform: translateY(1px);
  }

  .knopf-telefon {
    background: var(--color-action);
    color: var(--color-text-on-action);
  }

  .knopf-telefon:hover {
    background: var(--color-action-strong);
  }

  .knopf-telefon:active {
    background: var(--color-action-stronger);
    transform: translateY(1px);
  }

  .knopf-probe:focus-visible,
  .knopf-telefon:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .icon-telefon {
    width: 1.1em;
    height: 1.1em;
    flex-shrink: 0;
  }

  .zeiten {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  /* Fussnote zum Sternchen am Knopf — wie im Hero: klein, gedaempft,
     nicht kursiv. */
  .fussnote {
    margin: var(--space-2) auto 0;
    max-width: var(--measure-wide);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--color-text-subtle);
  }

  /* Zettel ----------------------------------------------------------------
     Der Vergleich liegt als weisses Blatt auf der dunklen Flaeche,
     leicht schraeg — wie das Blatt, das die Schuelerin im Hero haelt.
     Ohne Rundung: Papier hat Ecken.

     Er ist der einzige helle Bereich der Sektion und zieht damit den
     Blick, obwohl er inhaltlich nur einen Einwand beantwortet. Das ist
     gewollt: Der Vergleich ist das staerkste Argument gegen die
     beworbenen Kettenpreise.

     Innen gelten die Textrollen fuer --color-surface-inverse. */
  .zettel {
    --zettel-drehung: -1deg;

    margin: var(--space-28) auto 0;
    max-width: calc(2 * var(--measure-default) + var(--space-12) * 3);
    padding: var(--space-12) var(--space-6);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--zettel-drehung));
  }

  @media (min-width: 768px) {
    .zettel {
      padding: var(--space-12);
    }
  }

  .zettel h3 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-normal);
  }

  /* Die Ziffern kommen als Zaehler in der Displayschrift und in Rot:
     wie am Rand eines Blatts von Hand nummeriert. */
  .fragen {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: frage;
    display: grid;
    gap: var(--space-8) var(--space-12);
  }

  @media (min-width: 768px) {
    .fragen {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .fragen li {
    counter-increment: frage;
    display: grid;
    /* Feste Ziffernspalte: Die „2" ist in der Displayschrift breiter
       als die „1", bei `auto` staenden die Texte versetzt. */
    grid-template-columns: var(--space-12) 1fr;
    column-gap: var(--space-4);
    align-items: start;
  }

  .fragen li::before {
    content: counter(frage);
    grid-row: span 2;
    font-family: var(--font-family-display);
    font-size: var(--font-size-5xl);
    line-height: var(--line-height-tight);
    color: var(--color-brand);
  }

  .fragen p {
    margin: 0;
    color: var(--color-text-inverse-subtle);
  }

  .fragen .frage {
    color: var(--color-text-inverse);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-normal);
  }

  .fragen .frage + p {
    margin-top: var(--space-2);
  }

  /* Unterstrichen mit demselben Markerzug wie die gestrichenen Posten,
     nur unter der Zeile statt durch sie hindurch. */
  .fazit {
    margin: var(--space-12) 0 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    text-align: center;
  }

  .unterstrichen {
    position: relative;
    display: inline-block;
  }

  .unterstrichen .strich {
    top: 100%;
    transform: none;
  }

  /* Wer Bewegung im Browser abbestellt hat, bekommt alles gerade. Die
     Neigungen sind Dekoration; sie tragen keine Information. */
  @media (prefers-reduced-motion: reduce) {
    .betrag,
    .stempel,
    .zettel {
      --neigung: 0deg;
      --stempel-drehung: 0deg;
      --zettel-drehung: 0deg;
    }
  }
</style>
