---
// TESTSEITE — nur zur Beurteilung der Bildwirkung im Hero.
// Nicht Teil der Seite, kein Baustein. Alle Werte sind lokal in dieser
// Datei und fassen src/styles/tokens.css nicht an.
// Zahlen stammen aus design/pages/startseite/sections/01-hero/spec.md.
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test — Hero-Bildwirkung</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="/fonts/comic-neue-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="https://use.typekit.net/chw4hpk.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <section class="hero">
      <div class="wrap">
        <header class="kopf">
          <a class="logo" href="/" aria-label="#Lernstabil — Startseite">
            <span class="logo-wort">#Lernstabil</span>
            <span class="logo-claim">Nachhilfe bequem von zu Hause!</span>
          </a>
          <nav class="nav">
            <a href="#">Preise</a>
            <a href="#">Kontakt</a>
            <a href="#">Für Dozenten</a>
          </nav>
          <a class="kopf-tel" href="tel:+4934165832918">0341 658 329 18</a>
        </header>

        <div class="inhalt">
          <div class="text">
            <h1>
              <span class="zeile1">ONLINE EINZELUNTERRICHT</span>
              <span class="zeile2"
                >Ohne Vertrag, ohne Abo, ohne Kleingedrucktes.</span
              >
            </h1>

            <p class="unterzeile">
              Ein fester Dozent, der Ihr Kind kennt. Deutschlandweit, per Video.
              Die erste Stunde ist kostenlos.
            </p>

            <ul class="punkte">
              <li>Die ganze Stunde gehört einem Schüler</li>
              <li>Ein fester Dozent, der bleibt</li>
              <li>Sie entscheiden nach jeder Stunde neu</li>
            </ul>

            <div class="aktionen">
              <a class="knopf-primaer" href="tel:+4934165832918"
                >0341 658 329 18</a
              >
              <a class="knopf-sekundaer" href="#">Probestunde anfragen</a>
            </div>

            <p class="zeiten">Mo bis Fr, 9 bis 20 Uhr</p>
          </div>

          <div class="motiv">
            <img src="/test/hero-version-1-a4-3.png" alt="" />
          </div>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  /* Selbst gehostet, keine Laufzeitverbindung zu Google.
     Herkunft und Lizenz: design/type/comic-neue.md */
  @font-face {
    font-family: "Comic Neue";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/comic-neue-700-latin.woff2") format("woff2");
  }

  :root {
    --bg: #1a1a1a;
    --text: #ffffff;
    --text-muted: #b0b0b0;
    --accent: #ff0000;
    --accent-contrast: #ffffff;
    --border: #3a3a3a;

    --font-display: "six-hands-marker", system-ui, sans-serif;
    --font-body: "Source Sans 3", system-ui, sans-serif;

    --space-3xs: 4px;
    --space-2xs: 8px;
    --space-xs: 12px;
    --space-sm: 16px;
    --space-md: 24px;
    --space-lg: 32px;
    --space-xl: 48px;
    --space-2xl: 72px;
    --space-3xl: 112px;

    --radius-sm: 4px;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    /* Lichtkegel hinter dem Motiv, nachgebaut nach dem Studiolicht im
       Originalfoto: heller Bereich hinter Kopf und Schultern, nach
       aussen abfallend. Mobil sitzt er oben, weil das Motiv dort oben
       steht; ab 1120 rechts hinter der Person. */
    --licht-x: 50%;
    --licht-y: 24%;
    --licht-b: 90%;
    --licht-h: 55%;
    --licht-staerke: 0.075;

    background:
      radial-gradient(
        ellipse var(--licht-b) var(--licht-h) at var(--licht-x) var(--licht-y),
        rgb(255 255 255 / var(--licht-staerke)) 0%,
        rgb(255 255 255 / calc(var(--licht-staerke) * 0.45)) 45%,
        rgb(255 255 255 / 0) 75%
      ),
      var(--bg);
  }

  .wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Kopfzeile ------------------------------------------------------- */

  .kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) 0;
  }

  /* Logo als CSS-Nachbau. Alle Werte sind Bruchteile der Blockbreite
     --logo-b; der Block traegt font-size: var(--logo-b), dadurch ist
     1em = Blockbreite. Massverhaeltnisse aus design/brand/logo.svg
     abgemessen (Block 324 x 110,86). */
  .logo {
    --logo-b: 180px;
    display: inline-flex;
    flex-direction: column;
    box-sizing: border-box;
    flex: none;
    width: var(--logo-b);
    font-size: var(--logo-b);
    background: var(--accent);
    color: #fff;
    font-family: "Comic Neue", "Comic Sans MS", cursive;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    padding: 0.0279em 0.0621em 0.0481em 0.0571em;
    gap: 0.01157em;
  }

  .logo-wort {
    font-size: 0.18691em;
    letter-spacing: -0.02em;
  }

  .logo-claim {
    font-size: 0.06765em;
    letter-spacing: -0.033em;
    word-spacing: 0.0103em;
  }

  .nav {
    display: none;
    gap: var(--space-lg);
  }

  .nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 17px;
  }

  .kopf-tel {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-2xs) var(--space-sm);
    white-space: nowrap;
  }

  /* Inhalt ---------------------------------------------------------- */

  .inhalt {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .motiv {
    order: -1;
    margin: 0 -20px var(--space-lg);
  }

  .motiv img {
    display: block;
    width: 100%;
    height: auto;
  }

  .text {
    padding-bottom: var(--space-2xl);
  }

  h1 {
    margin: 0;
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .zeile1 {
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 700;
    line-height: 1.05;
  }

  .zeile2 {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
  }

  .unterzeile {
    margin: var(--space-md) 0 0;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .punkte {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .punkte li {
    position: relative;
    padding-left: 28px;
  }

  .punkte li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 8px;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
    transform: rotate(-45deg);
  }

  .aktionen {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .knopf-primaer,
  .knopf-sekundaer {
    display: block;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    padding: var(--space-xs) var(--space-lg);
    border-radius: var(--radius-sm);
  }

  .knopf-primaer {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .knopf-sekundaer {
    border: 1px solid var(--border);
    color: var(--text);
  }

  .zeiten {
    margin: var(--space-sm) 0 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  /* ab 768 ---------------------------------------------------------- */

  @media (min-width: 768px) {
    body {
      font-size: 18px;
    }

    .logo {
      --logo-b: 210px;
    }

    .wrap {
      padding: 0 48px;
    }

    .motiv {
      margin-left: -48px;
      margin-right: -48px;
    }

    .aktionen {
      flex-direction: row;
    }

    .knopf-primaer,
    .knopf-sekundaer {
      display: inline-block;
    }
  }

  /* ab 1120 — zweispaltig ------------------------------------------- */

  @media (min-width: 1120px) {
    .hero {
      --licht-x: 72%;
      --licht-y: 42%;
      --licht-b: 62%;
      --licht-h: 80%;
    }

    .kopf {
      padding: var(--space-md) 0 0;
    }

    .logo {
      --logo-b: 240px;
    }

    .nav {
      display: flex;
    }

    .inhalt {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
    }

    .text {
      flex: 0 0 55%;
      padding-top: var(--space-3xl);
      padding-bottom: var(--space-3xl);
    }

    .motiv {
      order: 0;
      flex: 1 1 45%;
      position: relative;
      margin: 0;
      padding: var(--space-3xl) 0 0;

      /* ------------------------------------------------------------
         FEINJUSTIERUNG MOTIV — nur diese drei Werte anfassen.
         Gilt ab 1120 px, also fuer die zweispaltige Ansicht.

         --motiv-hoehe   Hoehe des Bildes in Prozent der Spaltenhoehe.
                         Groesser = Bild groesser. Weil das Bild an der
                         rechten Kante haengt, waechst es nach links und
                         rueckt damit naeher an den Text.
                         Aktuell 87,5 % = 782 px hoch.

         --motiv-rechts  Wie weit das Bild ueber die rechte Kante des
                         Inhalts hinausragt. Groesser = weiter nach
                         rechts aus dem Raster heraus.

         --motiv-unten   Abstand der Bildunterkante zur Sektionskante.
                         0 = das Motiv wird von der Kante angeschnitten.
                         Positiv = das Bild hebt sich vom Rand ab.
         ------------------------------------------------------------ */
      --motiv-hoehe: 97%;
      --motiv-rechts: 48px;
      --motiv-unten: 0px;
    }

    /* Bild liegt als freigestelltes PNG vor (public/test/hero-version-1-a4-3.png,
       Herkunft und Nacharbeit: bildprompt.md). Kein Blend-Modus noetig. */
    .motiv img {
      position: absolute;
      bottom: var(--motiv-unten);
      right: calc(-1 * var(--motiv-rechts));
      height: var(--motiv-hoehe);
      width: auto;
      max-width: none;
      display: block;
    }
  }
</style>
