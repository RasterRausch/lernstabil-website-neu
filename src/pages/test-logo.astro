---
// Abgleichseite: CSS-Logo gegen das Original-SVG. Nur zur Kalibrierung.
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abgleich — Logo CSS vs. SVG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/comic-neue-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <p class="titel">Original (SVG), Blockbreite 324</p>
    <img class="orig" src="/test/logo.svg" alt="" />

    <p class="titel">CSS-Nachbau, Blockbreite 324</p>
    <span class="logo" id="css-logo">
      <span class="logo-wort">#Lernstabil</span>
      <span class="logo-claim">Nachhilfe bequem von zu Hause!</span>
    </span>

    <p class="titel">Übereinander (CSS über SVG, halbtransparent)</p>
    <div class="stapel">
      <img class="orig" src="/test/logo.svg" alt="" />
      <span class="logo ueber">
        <span class="logo-wort">#Lernstabil</span>
        <span class="logo-claim">Nachhilfe bequem von zu Hause!</span>
      </span>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Comic Neue';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/comic-neue-700-latin.woff2') format('woff2');
  }

  body { margin: 40px; background: #fff; font: 14px system-ui; }
  .titel { color: #666; margin: 32px 0 8px; }
  .orig { width: 324px; display: block; }
  .stapel { position: relative; width: 324px; }
  .stapel .ueber { position: absolute; inset: 0; opacity: .5; }

  /* --- CSS-Logo ------------------------------------------------------ */
  /* Alle Werte sind Bruchteile der Blockbreite --logo-b. Der Container
     traegt font-size: var(--logo-b), dadurch ist 1em = Blockbreite. */
  .logo {
    --logo-b: 324px;
    display: inline-flex;
    flex-direction: column;
    box-sizing: border-box;
    width: var(--logo-b);
    font-size: var(--logo-b);
    background: #ff0000;
    color: #fff;
    font-family: 'Comic Neue', 'Comic Sans MS', cursive;
    font-weight: 700;
    padding: 0.0279em 0.0621em 0.0481em 0.0571em;
    gap: 0.01157em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-wort {
    font-size: 0.18691em;
    letter-spacing: -0.02em;
  }
  .logo-claim {
    font-size: 0.06765em;
    letter-spacing: -0.033em;
    word-spacing: 0.0103em;
  }
</style>
