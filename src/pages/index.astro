import VorteileOnline from '../components/sections/VorteileOnline.astro';
import Schulfaecher from '../components/sections/Schulfaecher.astro';
---

<BaseLayout
  title="#Lernstabil — Online-Einzelunterricht ohne Vertragslaufzeit"
  description="Nachhilfe, die ankommt. Erste Stunde gratis testen. Online-Einzelunterricht ohne Vertragslaufzeit, Mo bis Fr 9 bis 20 Uhr."
>
  <main id="inhalt">
    {/* Eine Sektion pro Durchgang. */}
    <Hero />
    <Vertrauensleiste />
    <WasUnsUnterscheidet />
    <VorteileOnline />
    <Schulfaecher />
