---
// Bestaetigung nach dem Absenden ohne JavaScript (mit JavaScript zeigt
// das Formular die Bestaetigung selbst). Angelegt am 27. September 2026.
// Kann spaeter auch als Conversion-Seite fuer Google Ads dienen.
//
// Nicht in Suchmaschinen: Wer hier ohne Anfrage landet, waere irritiert.

import BaseLayout from "../layouts/BaseLayout.astro";
import Getarnt from "../components/Getarnt.astro";
import { telefon, verschluesseln } from "../data/kontakt";
---

<BaseLayout title="Danke für Ihre Anfrage — #Lernstabil" noindex>
  <main id="inhalt" class="seite">
    <div class="wrap">
      <h1>Danke!</h1>
      <p>
        Ihre Anfrage ist bei uns angekommen. <strong
          >Wir melden uns innerhalb von 24 Stunden.</strong
        >
      </p>
      <p>
        Die Probestunde dauert 45 Minuten und kostet nichts. Am Ende bekommen
        Sie einen Unterrichtsplan – verpflichtet sind Sie zu nichts.
      </p>
      <p>
        Lieber gleich sprechen?{" "}
        <a data-kontakt={verschluesseln(telefon.href)}
          ><Getarnt text={telefon.anzeige} /></a
        >, Mo bis Fr von 9 bis 20 Uhr.
      </p>
      <p><a href="/">Zurück zur Startseite</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  .seite {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    padding: var(--space-18) 0 var(--space-28);
  }

  .wrap {
    width: 100%;
    max-width: calc(var(--measure-wide) + 2 * var(--layout-gutter));
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  h1 {
    margin: 0 0 var(--space-6);
    font-family: var(--font-family-display);
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-display);
    line-height: var(--line-height-snug);
  }

  p {
    margin: var(--space-3) 0 0;
  }

  a {
    color: var(--color-action);
  }

  /* Fokusring fuer helle Flaechen, siehe tokens.css. */
  a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring-inverse);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }
</style>
